# Server Configuration
PORT=3000

# Gemini AI API (Server-side proxy /api/ai/*)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# Firebase Admin Service Account JSON (optional — enables server-side Firestore API key vault & admin verification)
FIREBASE_SERVICE_ACCOUNT_JSON=""

# App URL (Automatically injected at runtime for callbacks/links)
APP_URL="MY_APP_URL"

# Direct SMTP B2B Email Sending (/api/email/send & /api/email/status)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Orange Pro Maroc <pro@orange.ma>"

# WebRTC TURN Relay Server (optional — improves audio coaching NAT traversal on 4G/5G/Corporate networks)
TURN_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""


