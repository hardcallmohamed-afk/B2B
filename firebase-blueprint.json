{
  "entities": {
    "UserWorkspaceConfig": {
      "title": "UserWorkspaceConfig",
      "description": "Configuration persistante du portefeuille Orange Pro d'un utilisateur (villes cibles, signature email, état d'initialisation).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "villesAll": {
          "type": "array",
          "description": "Liste bornée des villes configurées (max 50)."
        },
        "villesActive": {
          "type": "array",
          "description": "Liste bornée des villes cochées actives (max 50)."
        },
        "modeVille": {
          "type": "string",
          "enum": ["filter", "default"]
        },
        "defaultVille": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "emailSignature": {
          "type": "string",
          "maxLength": 400
        },
        "seeded": {
          "type": "boolean"
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "avatarDataUrl": {
          "type": "string",
          "maxLength": 45000,
          "pattern": "^(|data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+)$"
        },
        "phonePro": {
          "type": "string",
          "maxLength": 30
        },
        "zone": {
          "type": "string",
          "maxLength": 100
        },
        "bio": {
          "type": "string",
          "maxLength": 240
        },
        "monthlyGoalContracts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "notifyBadges": {
          "type": "boolean"
        },
        "notifySound": {
          "type": "boolean"
        },
        "compactUi": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "villesAll",
        "villesActive",
        "modeVille",
        "defaultVille",
        "emailSignature",
        "seeded",
        "createdAt",
        "updatedAt"
      ]
    },
    "FicheEntreprise": {
      "title": "FicheEntreprise",
      "description": "Fiche prospect B2B Orange Pro Maroc (schéma strict 9 colonnes + métadonnées CRM et enrichissement).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "numeroFiche": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Z0-9_\\-]+$",
          "description": "Numéro de fiche unique client (ex. OP-0001)."
        },
        "societe": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "secteur": {
          "type": "string",
          "enum": [
            "fiduciaire",
            "clinique",
            "notaire",
            "immobilier",
            "riad_hotellerie",
            "auto_ecole",
            "pme",
            "industrie",
            "btp",
            "gros",
            "enseignement",
            "liberal",
            "commerce"
          ]
        },
        "ville": {
          "type": "string",
          "maxLength": 100
        },
        "telephone": {
          "type": "string",
          "maxLength": 30
        },
        "telephonesSupplementaires": {
          "type": "array",
          "description": "Numéros de téléphone additionnels du client (max 10)."
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "emailsSupplementaires": {
          "type": "array",
          "description": "Adresses email additionnelles du client (max 10)."
        },
        "contact": {
          "type": "string",
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "maxLength": 120
        },
        "source": {
          "type": "string",
          "maxLength": 500
        },
        "effectif": {
          "type": "string",
          "maxLength": 20
        },
        "statut": {
          "type": "string",
          "enum": [
            "À contacter",
            "Appel en cours",
            "RDV pris",
            "Devis envoyé",
            "Signé Orange Pro",
            "Pas intéressé"
          ]
        },
        "siteWeb": {
          "type": "string",
          "maxLength": 500
        },
        "verifieWeb": {
          "type": "boolean"
        },
        "pistesEnrichissement": {
          "type": "array",
          "description": "Liste bornée des sources d'enrichissement (max 15)."
        },
        "dateAjout": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "id",
        "societe",
        "secteur",
        "ville",
        "telephone",
        "email",
        "contact",
        "role",
        "source",
        "effectif",
        "statut",
        "dateAjout",
        "createdAt",
        "updatedAt"
      ]
    },
    "EmailSkill": {
      "title": "EmailSkill",
      "description": "Skill de rédaction commerciale B2B personnalisé pour le Studio Email IA.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nom": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "role": {
          "type": "string",
          "maxLength": 200
        },
        "regles": {
          "type": "string",
          "maxLength": 4000
        },
        "ctaStyle": {
          "type": "string",
          "maxLength": 300
        },
        "isBuiltin": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "id",
        "nom",
        "description",
        "role",
        "regles",
        "ctaStyle",
        "createdAt",
        "updatedAt"
      ]
    },
    "AppUser": {
      "title": "AppUser",
      "description": "Compte utilisateur autorisé créé exclusivement par le Super-Admin pour accéder à l'application CRM Orange Pro.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["commercial", "manager"]
        },
        "zone": {
          "type": "string",
          "maxLength": 100
        },
        "active": {
          "type": "boolean"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "role",
        "zone",
        "active",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "TeamStat": {
      "title": "TeamStat",
      "description": "Indicateurs de performance non-PII, classement équipe, XP et badges attribués par collaborateur.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orgScope": {
          "type": "string",
          "enum": ["orange_pro_team"]
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["super_admin", "manager", "commercial"]
        },
        "zone": {
          "type": "string",
          "maxLength": 100
        },
        "active": {
          "type": "boolean"
        },
        "totalProspects": {
          "type": "integer"
        },
        "totalQualified": {
          "type": "integer"
        },
        "totalContracts": {
          "type": "integer"
        },
        "totalPayoutMad": {
          "type": "number"
        },
        "xp": {
          "type": "integer"
        },
        "unlockedCount": {
          "type": "integer"
        },
        "manualBadges": {
          "type": "array",
          "description": "Identifiants des badges de distinction attribués exclusivement par le Super-Admin (max 20)."
        },
        "monthlyHistory": {
          "type": "array",
          "description": "Historique mensuel agrégé YYYY-MM:contrats:payout (max 24)."
        },
        "avatarDataUrl": {
          "type": "string",
          "maxLength": 45000,
          "pattern": "^(|data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+)$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "orgScope",
        "displayName",
        "role",
        "zone",
        "active",
        "totalProspects",
        "totalQualified",
        "totalContracts",
        "totalPayoutMad",
        "xp",
        "unlockedCount",
        "manualBadges",
        "monthlyHistory",
        "createdAt",
        "updatedAt"
      ]
    },
    "SignedContract": {
      "title": "SignedContract",
      "description": "Registre des contrats Orange Pro signés et payouts commissions (sans PII client — téléphone/email exclus).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orgScope": {
          "type": "string",
          "enum": ["orange_pro_team"]
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "ficheId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "numeroFiche": {
          "type": "string",
          "maxLength": 32
        },
        "societe": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "ville": {
          "type": "string",
          "maxLength": 100
        },
        "secteur": {
          "type": "string",
          "enum": [
            "fiduciaire",
            "clinique",
            "notaire",
            "immobilier",
            "riad_hotellerie",
            "auto_ecole",
            "pme",
            "industrie",
            "btp",
            "gros",
            "enseignement",
            "liberal",
            "commerce"
          ]
        },
        "produitOrangePro": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "tier": {
          "type": "string",
          "enum": ["Grand Compte", "PME", "TPE / Libéral"]
        },
        "effectif": {
          "type": "string",
          "maxLength": 20
        },
        "payoutMad": {
          "type": "number"
        },
        "payoutStatus": {
          "type": "string",
          "enum": ["En attente", "Validé", "Versé"]
        },
        "signedAt": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "orgScope",
        "ownerId",
        "ownerName",
        "ficheId",
        "numeroFiche",
        "societe",
        "ville",
        "secteur",
        "produitOrangePro",
        "tier",
        "effectif",
        "payoutMad",
        "payoutStatus",
        "signedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "ApiKeyConfig": {
      "title": "ApiKeyConfig",
      "description": "Clé API externe sécurisée stockée dans /api_keys/{provider}, strictement réservée en lecture et écriture au Super-Admin.",
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9_\\-]+$"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "active": {
          "type": "boolean"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "provider",
        "key",
        "label",
        "active",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/api_keys/{provider}": {
      "schema": {
        "$ref": "#/entities/ApiKeyConfig"
      },
      "description": "Coffre des clés API externes (Groq, Mistral, Gemini, etc.) accessible exclusivement au Super-Admin."
    },
    "/app_users/{userId}": {
      "schema": {
        "$ref": "#/entities/AppUser"
      },
      "description": "Répertoire des comptes utilisateurs autorisés, administré exclusivement par le Super-Admin."
    },
    "/team_stats/{userId}": {
      "schema": {
        "$ref": "#/entities/TeamStat"
      },
      "description": "Classement d'équipe non-PII, XP, badges et évolution mensuelle des collaborateurs."
    },
    "/signed_contracts/{contractId}": {
      "schema": {
        "$ref": "#/entities/SignedContract"
      },
      "description": "Contrats Orange Pro signés avec produit et payout MAD (accès fiche client verrouillé pour les collaborateurs après signature)."
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserWorkspaceConfig"
      },
      "description": "Configuration du workspace Orange Pro isolée par utilisateur authentifié."
    },
    "/users/{userId}/fiches/{ficheId}": {
      "schema": {
        "$ref": "#/entities/FicheEntreprise"
      },
      "description": "Fiches prospects CRM B2B appartenant exclusivement à l'utilisateur."
    },
    "/users/{userId}/skills/{skillId}": {
      "schema": {
        "$ref": "#/entities/EmailSkill"
      },
      "description": "Skills de rédaction Email IA appartenant exclusivement à l'utilisateur."
    }
  }
}
