{
  "entities": {
    "UserWorkspaceConfig": {
      "title": "UserWorkspaceConfig",
      "description": "Configuration persistante du portefeuille Orange Pro d'un utilisateur (villes cibles, signature email, état d'initialisation).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "villesAll": {
          "type": "array",
          "description": "Liste bornée des villes configurées (max 50)."
        },
        "villesActive": {
          "type": "array",
          "description": "Liste bornée des villes cochées actives (max 50)."
        },
        "modeVille": {
          "type": "string",
          "enum": ["filter", "default"]
        },
        "defaultVille": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "emailSignature": {
          "type": "string",
          "maxLength": 400
        },
        "seeded": {
          "type": "boolean"
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "avatarDataUrl": {
          "type": "string",
          "maxLength": 45000,
          "pattern": "^(|data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+)$"
        },
        "phonePro": {
          "type": "string",
          "maxLength": 30
        },
        "zone": {
          "type": "string",
          "maxLength": 100
        },
        "bio": {
          "type": "string",
          "maxLength": 240
        },
        "monthlyGoalContracts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "notifyBadges": {
          "type": "boolean"
        },
        "notifySound": {
          "type": "boolean"
        },
        "compactUi": {
          "type": "boolean"
        },
        "dismissedDedupKeys": {
          "type": "array",
          "description": "Groupes de doublons explicitement marqués comme distincts par l'utilisateur (max 100)."
        },
        "includePhoneOnlyDedup": {
          "type": "boolean"
        },
        "legalRaisonSociale": {
          "type": "string",
          "maxLength": 200,
          "description": "Raison sociale officielle DIVERSIFIA à compléter dans Mon Compte pour les devis clients."
        },
        "legalIce": {
          "type": "string",
          "maxLength": 30,
          "description": "Identifiant Commun de l'Entreprise (ICE) légal pour les devis."
        },
        "legalAdresse": {
          "type": "string",
          "maxLength": 300,
          "description": "Adresse du siège DIVERSIFIA pour les devis."
        },
        "legalTelephone": {
          "type": "string",
          "maxLength": 30,
          "description": "Numéro de téléphone officiel du siège pour les devis."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "villesAll",
        "villesActive",
        "modeVille",
        "defaultVille",
        "emailSignature",
        "seeded",
        "createdAt",
        "updatedAt"
      ]
    },
