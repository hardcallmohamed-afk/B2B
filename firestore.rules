rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    function isSuperAdmin() {
      return isVerifiedUser()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'hardcallmohamed@gmail.com';
    }
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function isValidProviderId(id) {
      return id is string && id.size() >= 1 && id.size() <= 64 && id.matches('^[a-z0-9_\\-]+$');
    }
    function isValidNumeroFiche(val) {
      return val is string && val.size() >= 1 && val.size() <= 32 && val.matches('^[A-Z0-9_\\-]+$');
    }
    function isApprovedMember(userId) {
      return isVerifiedUser()
        && request.auth.uid == userId
        && exists(/databases/$(database)/documents/app_users/$(userId))
        && get(/databases/$(database)/documents/app_users/$(userId)).data.active == true;
    }
    function isOwner(userId) {
      return (isSuperAdmin() && request.auth.uid == userId) || isApprovedMember(userId);
    }

    function isValidSecteur(val) {
      return val is string && val in [
        'fiduciaire', 'clinique', 'notaire', 'immobilier', 'riad_hotellerie',
        'auto_ecole', 'pme', 'industrie', 'btp', 'gros', 'enseignement',
        'liberal', 'commerce'
      ];
    }

    function isValidStatut(val) {
      return val is string && val in [
        'À contacter', 'Appel en cours', 'RDV pris',
        'Devis envoyé', 'Signé Orange Pro', 'Pas intéressé'
      ];
    }

    function isValidManagedRole(val) {
      return val is string && val in ['commercial', 'grand_compte', 'team_lead', 'manager'];
    }

    function isValidTeamRole(val) {
      return val is string && val in ['super_admin', 'manager', 'team_lead', 'grand_compte', 'commercial'];
    }

    function isValidOrangeTier(val) {
      return val is string && val in ['Grand Compte', 'PME', 'TPE / Libéral'];
    }

    function isValidPayoutStatus(val) {
      return val is string && val in ['En attente', 'Validé', 'Versé', 'Refusé'];
    }

    function isValidDeviceType(val) {
      return val is string && val in ['desktop', 'mobile', 'tablet'];
    }

    function isValidSessionStatus(val) {
      return val is string && val in ['active', 'closed', 'disconnected_work_hours'];
    }

    function isManager() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/app_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/app_users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/app_users/$(request.auth.uid)).data.role == 'manager';
    }

    function isTeamLeadOrManager() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/app_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/app_users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/app_users/$(request.auth.uid)).data.role in ['manager', 'team_lead'];
    }

    function isValidActiviteType(val) {
      return val is string && val in [
        'appel', 'whatsapp', 'email', 'visite', 'note', 'rdv', 'devis', 'statut',
        'attribution', 'acces', 'modification', 'restitution', 'signature'
      ];
    }

    function isValidActiviteResultat(val) {
      return val is string && val in [
        'joint', 'pas_de_reponse', 'rappeler', 'rdv_fixe', 'refus', 'autre', 'vide'
      ];
    }

    function isValidAuditAction(val) {
      return val is string && val in [
        'created', 'field_updated', 'status_changed', 'assigned', 'restored',
        'signed', 'accessed', 'activity_logged', 'rdv_scheduled',
        'quote_generated', 'web_verified', 'enriched'
      ];
    }

    function isValidCoachingStatus(val) {
      return val is string && val in ['idle', 'collab_ready', 'live', 'ended'];
    }

    function isValidNotificationKind(val) {
      return val is string && val in [
        'fiche_assigned', 'fiche_accessed', 'fiche_restored', 'fiche_updated',
        'contract_signed', 'contract_status_changed', 'direct_message', 'coaching_invite'
      ];
    }

    function isValidNotificationTab(val) {
      return val is string && val in ['crm', 'team', 'badges'];
    }

    function canSuperviseTeam() {
      return isSuperAdmin() || isTeamLeadOrManager();
    }

    function isValidStringList(arr, maxItems, maxItemLen) {
      return arr is list
        && arr.size() <= maxItems
        && (
          arr.size() == 0
          || (
            arr[0] is string
            && arr[0].size() <= maxItemLen
            && (arr.size() < 2 || (arr[1] is string && arr[1].size() <= maxItemLen))
            && arr[arr.size() - 1] is string
            && arr[arr.size() - 1].size() <= maxItemLen
          )
        );
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap)
    function isValidAppUser(data, targetUid) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'role', 'zone', 'active',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'role', 'zone', 'active',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.uid is string
        && data.uid == targetUid
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && isValidManagedRole(data.role)
        && data.zone is string && data.zone.size() <= 100
        && data.active is bool
        && data.createdBy is string
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidApiKeyConfig(data, provider) {
      return data.keys().hasAll([
          'provider', 'label', 'key', 'active', 'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'provider', 'label', 'key', 'active', 'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.provider is string
        && data.provider == provider
        && isValidProviderId(data.provider)
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 120
        && data.key is string && data.key.size() >= 1 && data.key.size() <= 512
        && data.active is bool
        && data.updatedBy is string
        && isValidId(data.updatedBy)
        && data.updatedBy == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAvatarDataUrl(val) {
      return val is string
        && val.size() <= 45000
        && (val == '' || val.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$'));
    }

    function isValidTeamStat(data, targetUid) {
      return data.keys().hasAll([
          'uid', 'orgScope', 'displayName', 'role', 'zone', 'active',
          'totalProspects', 'totalQualified', 'totalContracts', 'totalPayoutMad',
          'xp', 'unlockedCount', 'manualBadges', 'monthlyHistory',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'orgScope', 'displayName', 'role', 'zone', 'active',
          'totalProspects', 'totalQualified', 'totalContracts', 'totalPayoutMad',
          'xp', 'unlockedCount', 'manualBadges', 'monthlyHistory',
          'avatarDataUrl', 'createdAt', 'updatedAt'
        ])
        && data.uid is string
        && data.uid == targetUid
        && isValidId(data.uid)
        && data.orgScope is string && data.orgScope == 'orange_pro_team'
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && isValidTeamRole(data.role)
        && data.zone is string && data.zone.size() <= 100
        && data.active is bool
        && data.totalProspects is number && data.totalProspects >= 0 && data.totalProspects <= 100000
        && data.totalQualified is number && data.totalQualified >= 0 && data.totalQualified <= 100000
        && data.totalContracts is number && data.totalContracts >= 0 && data.totalContracts <= 100000
        && data.totalPayoutMad is number && data.totalPayoutMad >= 0 && data.totalPayoutMad <= 100000000
        && data.xp is number && data.xp >= 0 && data.xp <= 10000000
        && data.unlockedCount is number && data.unlockedCount >= 0 && data.unlockedCount <= 100
        && isValidStringList(data.manualBadges, 20, 64)
        && isValidStringList(data.monthlyHistory, 24, 40)
        && (!('avatarDataUrl' in data) || isValidAvatarDataUrl(data.avatarDataUrl))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSignedContract(data, contractId) {
      return data.keys().hasAll([
          'id', 'orgScope', 'ownerId', 'ownerName', 'ficheId', 'numeroFiche',
          'societe', 'ville', 'secteur', 'produitOrangePro', 'tier', 'effectif',
          'payoutMad', 'payoutStatus', 'signedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'orgScope', 'ownerId', 'ownerName', 'ficheId', 'numeroFiche',
          'societe', 'ville', 'secteur', 'produitOrangePro', 'tier', 'effectif',
          'payoutMad', 'payoutStatus', 'signedAt', 'referenceVirement', 'refusMotif', 'createdAt', 'updatedAt'
        ])
        && data.id is string
        && data.id == contractId
        && isValidId(data.id)
        && data.orgScope is string && data.orgScope == 'orange_pro_team'
        && data.ownerId is string && isValidId(data.ownerId)
        && data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 120
        && data.ficheId is string && isValidId(data.ficheId)
        && data.numeroFiche is string && data.numeroFiche.size() <= 32
        && data.societe is string && data.societe.size() >= 1 && data.societe.size() <= 200
        && data.ville is string && data.ville.size() <= 100
        && isValidSecteur(data.secteur)
        && data.produitOrangePro is string && data.produitOrangePro.size() >= 1 && data.produitOrangePro.size() <= 200
        && isValidOrangeTier(data.tier)
        && data.effectif is string && data.effectif.size() <= 20
        && data.payoutMad is number && data.payoutMad >= 0 && data.payoutMad <= 10000000
        && isValidPayoutStatus(data.payoutStatus)
        && data.signedAt is string && data.signedAt.size() <= 64
        && (!('referenceVirement' in data) || (data.referenceVirement is string && data.referenceVirement.size() <= 80))
        && (!('refusMotif' in data) || (data.refusMotif is string && data.refusMotif.size() <= 200))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPresence(data, targetUid) {
      return data.keys().hasAll([
          'uid', 'orgScope', 'email', 'displayName', 'firstName', 'lastName',
          'phonePro', 'avatarDataUrl', 'role', 'zone', 'isOnline',
          'currentDevice', 'devicesUsed', 'lastLoginAt', 'lastLogoutAt',
          'lastSeenAt', 'lastWorkDisconnectAt', 'workHoursDisconnectCount',
          'workHoursDisconnectTimes', 'activeDateKey', 'todayWorkedSeconds',
          'totalWorkedSeconds', 'currentSessionId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'orgScope', 'email', 'displayName', 'firstName', 'lastName',
          'phonePro', 'avatarDataUrl', 'role', 'zone', 'isOnline',
          'currentDevice', 'devicesUsed', 'lastLoginAt', 'lastLogoutAt',
          'lastSeenAt', 'lastWorkDisconnectAt', 'workHoursDisconnectCount',
          'workHoursDisconnectTimes', 'activeDateKey', 'todayWorkedSeconds',
          'totalWorkedSeconds', 'currentSessionId', 'createdAt', 'updatedAt'
        ])
        && data.uid is string
        && data.uid == targetUid
        && isValidId(data.uid)
        && data.orgScope is string && data.orgScope == 'orange_pro_team'
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.firstName is string && data.firstName.size() <= 60
        && data.lastName is string && data.lastName.size() <= 60
        && data.phonePro is string && data.phonePro.size() <= 30
        && isValidAvatarDataUrl(data.avatarDataUrl)
        && isValidTeamRole(data.role)
        && data.zone is string && data.zone.size() <= 100
        && data.isOnline is bool
        && data.currentDevice is string && data.currentDevice.size() <= 160
        && isValidStringList(data.devicesUsed, 12, 160)
        && data.lastLoginAt is string && data.lastLoginAt.size() <= 64
        && data.lastLogoutAt is string && data.lastLogoutAt.size() <= 64
        && data.lastSeenAt is string && data.lastSeenAt.size() <= 64
        && data.lastWorkDisconnectAt is string && data.lastWorkDisconnectAt.size() <= 64
        && data.workHoursDisconnectCount is number && data.workHoursDisconnectCount >= 0 && data.workHoursDisconnectCount <= 100000
        && isValidStringList(data.workHoursDisconnectTimes, 30, 80)
        && data.activeDateKey is string && data.activeDateKey.size() <= 16
        && data.todayWorkedSeconds is number && data.todayWorkedSeconds >= 0 && data.todayWorkedSeconds <= 86400
        && data.totalWorkedSeconds is number && data.totalWorkedSeconds >= 0 && data.totalWorkedSeconds <= 100000000
        && data.currentSessionId is string && (data.currentSessionId == '' || isValidId(data.currentSessionId))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAttendanceSession(data, userId, sessionId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'orgScope', 'dateKey', 'loginAt', 'lastSeenAt',
          'logoutAt', 'workedSeconds', 'deviceLabel', 'deviceType', 'status',
          'disconnectReason', 'disconnectedDuringWorkHours', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'orgScope', 'dateKey', 'loginAt', 'lastSeenAt',
          'logoutAt', 'workedSeconds', 'deviceLabel', 'deviceType', 'status',
          'disconnectReason', 'disconnectedDuringWorkHours', 'createdAt', 'updatedAt'
        ])
        && data.id is string
        && data.id == sessionId
        && isValidId(data.id)
        && data.ownerId is string
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.orgScope is string && data.orgScope == 'orange_pro_team'
        && data.dateKey is string && data.dateKey.size() >= 8 && data.dateKey.size() <= 16
        && data.loginAt is string && data.loginAt.size() >= 1 && data.loginAt.size() <= 64
        && data.lastSeenAt is string && data.lastSeenAt.size() >= 1 && data.lastSeenAt.size() <= 64
        && data.logoutAt is string && data.logoutAt.size() <= 64
        && data.workedSeconds is number && data.workedSeconds >= 0 && data.workedSeconds <= 86400
        && data.deviceLabel is string && data.deviceLabel.size() >= 1 && data.deviceLabel.size() <= 160
        && isValidDeviceType(data.deviceType)
        && isValidSessionStatus(data.status)
        && data.disconnectReason is string && data.disconnectReason.size() <= 80
        && data.disconnectedDuringWorkHours is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserWorkspaceConfig(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'villesAll', 'villesActive', 'modeVille',
          'defaultVille', 'emailSignature', 'seeded', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'villesAll', 'villesActive', 'modeVille',
          'defaultVille', 'emailSignature', 'seeded',
          'displayName', 'avatarDataUrl', 'phonePro', 'zone', 'bio',
          'monthlyGoalContracts', 'notifyBadges', 'notifySound', 'compactUi',
          'dismissedDedupKeys', 'includePhoneOnlyDedup',
          'legalRaisonSociale', 'legalIce', 'legalAdresse', 'legalTelephone',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isValidStringList(data.villesAll, 50, 100)
        && isValidStringList(data.villesActive, 50, 100)
        && data.modeVille is string
        && data.modeVille in ['filter', 'default']
        && data.defaultVille is string
        && data.defaultVille.size() >= 1 && data.defaultVille.size() <= 80
        && data.emailSignature is string
        && data.emailSignature.size() <= 400
        && data.seeded is bool
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('avatarDataUrl' in data) || isValidAvatarDataUrl(data.avatarDataUrl))
        && (!('phonePro' in data) || (data.phonePro is string && data.phonePro.size() <= 30))
        && (!('zone' in data) || (data.zone is string && data.zone.size() <= 100))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 240))
        && (!('monthlyGoalContracts' in data) || (data.monthlyGoalContracts is number && data.monthlyGoalContracts >= 1 && data.monthlyGoalContracts <= 200))
        && (!('notifyBadges' in data) || data.notifyBadges is bool)
        && (!('notifySound' in data) || data.notifySound is bool)
        && (!('compactUi' in data) || data.compactUi is bool)
        && (!('dismissedDedupKeys' in data) || isValidStringList(data.dismissedDedupKeys, 100, 200))
        && (!('includePhoneOnlyDedup' in data) || data.includePhoneOnlyDedup is bool)
        && (!('legalRaisonSociale' in data) || (data.legalRaisonSociale is string && data.legalRaisonSociale.size() <= 200))
        && (!('legalIce' in data) || (data.legalIce is string && data.legalIce.size() <= 30))
        && (!('legalAdresse' in data) || (data.legalAdresse is string && data.legalAdresse.size() <= 300))
        && (!('legalTelephone' in data) || (data.legalTelephone is string && data.legalTelephone.size() <= 30))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFicheEntreprise(data, userId, ficheId) {
      return data.keys().hasAll([
          'ownerId', 'id', 'societe', 'secteur', 'ville', 'telephone',
          'email', 'contact', 'role', 'source', 'effectif', 'statut',
          'dateAjout', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'id', 'numeroFiche', 'societe', 'secteur', 'ville',
          'telephone', 'telephonesSupplementaires', 'email', 'emailsSupplementaires',
          'contact', 'role', 'source', 'effectif', 'statut', 'statutUpdatedAt',
          'siteWeb', 'verifieWeb', 'pistesEnrichissement',
          'prochaineRelanceAt', 'rdvAt', 'rdvLieu',
          'assignedByUid', 'assignedByName', 'assignedAt',
          'restoredByName', 'restoredAt', 'restoredReason',
          'dateAjout', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.id is string
        && data.id == ficheId
        && isValidId(data.id)
        && (!('numeroFiche' in data) || isValidNumeroFiche(data.numeroFiche))
        && data.societe is string && data.societe.size() >= 1 && data.societe.size() <= 200
        && isValidSecteur(data.secteur)
        && data.ville is string && data.ville.size() <= 100
        && data.telephone is string && data.telephone.size() <= 30
        && (!('telephonesSupplementaires' in data) || isValidStringList(data.telephonesSupplementaires, 10, 30))
        && data.email is string && data.email.size() <= 160
        && (!('emailsSupplementaires' in data) || isValidStringList(data.emailsSupplementaires, 10, 160))
        && data.contact is string && data.contact.size() <= 160
        && data.role is string && data.role.size() <= 120
        && data.source is string && data.source.size() <= 500
        && data.effectif is string && data.effectif.size() <= 20
        && isValidStatut(data.statut)
        && (!('statutUpdatedAt' in data) || (data.statutUpdatedAt is string && data.statutUpdatedAt.size() <= 64))
        && (!('siteWeb' in data) || (data.siteWeb is string && data.siteWeb.size() <= 500))
        && (!('verifieWeb' in data) || (data.verifieWeb is bool))
        && (!('pistesEnrichissement' in data) || isValidStringList(data.pistesEnrichissement, 15, 250))
        && (!('prochaineRelanceAt' in data) || (data.prochaineRelanceAt is string && data.prochaineRelanceAt.size() <= 64))
        && (!('rdvAt' in data) || (data.rdvAt is string && data.rdvAt.size() <= 64))
        && (!('rdvLieu' in data) || (data.rdvLieu is string && data.rdvLieu.size() <= 160))
        && (!('assignedByUid' in data) || (data.assignedByUid is string && isValidId(data.assignedByUid)))
        && (!('assignedByName' in data) || (data.assignedByName is string && data.assignedByName.size() <= 120))
        && (!('assignedAt' in data) || (data.assignedAt is string && data.assignedAt.size() <= 64))
        && (!('restoredByName' in data) || (data.restoredByName is string && data.restoredByName.size() <= 120))
        && (!('restoredAt' in data) || (data.restoredAt is string && data.restoredAt.size() <= 64))
        && (!('restoredReason' in data) || (data.restoredReason is string && data.restoredReason.size() <= 300))
        && data.dateAjout is string && data.dateAjout.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFicheActivite(data, userId, ficheId, activiteId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'ficheId', 'type', 'resultat', 'texte',
          'auteurNom', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'ficheId', 'type', 'resultat', 'texte',
          'auteurNom', 'auteurUid', 'auteurRole', 'createdAtIso',
          'rdvAt', 'rdvLieu', 'prochaineRelanceAt',
          'createdAt', 'updatedAt'
        ])
        && data.id is string
        && data.id == activiteId
        && isValidId(data.id)
        && data.ownerId is string
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.ficheId is string
        && data.ficheId == ficheId
        && isValidId(data.ficheId)
        && isValidActiviteType(data.type)
        && isValidActiviteResultat(data.resultat)
        && data.texte is string && data.texte.size() <= 1000
        && data.auteurNom is string && data.auteurNom.size() >= 1 && data.auteurNom.size() <= 120
        && (!('auteurUid' in data) || (data.auteurUid is string && isValidId(data.auteurUid)))
        && (!('auteurRole' in data) || (data.auteurRole is string && data.auteurRole.size() <= 40))
        && (!('createdAtIso' in data) || (data.createdAtIso is string && data.createdAtIso.size() <= 64))
        && (!('rdvAt' in data) || (data.rdvAt is string && data.rdvAt.size() <= 64))
        && (!('rdvLieu' in data) || (data.rdvLieu is string && data.rdvLieu.size() <= 160))
        && (!('prochaineRelanceAt' in data) || (data.prochaineRelanceAt is string && data.prochaineRelanceAt.size() <= 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAppNotification(data, notifId) {
      return data.keys().hasAll([
          'id', 'orgScope', 'recipientUid', 'senderUid', 'senderName',
          'kind', 'title', 'message', 'read', 'createdAtIso',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'orgScope', 'recipientUid', 'senderUid', 'senderName', 'senderRole',
          'kind', 'title', 'message', 'ficheId', 'ficheOwnerId', 'numeroFiche',
          'societe', 'payoutStatus', 'payoutMad', 'targetTab', 'read', 'createdAtIso',
          'createdAt', 'updatedAt'
        ])
        && data.id is string
        && data.id == notifId
        && isValidId(data.id)
        && data.orgScope is string && data.orgScope == 'orange_pro_team'
        && data.recipientUid is string && isValidId(data.recipientUid)
        && data.senderUid is string && isValidId(data.senderUid)
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 120
        && (!('senderRole' in data) || (data.senderRole is string && data.senderRole.size() <= 40))
        && isValidNotificationKind(data.kind)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.message is string && data.message.size() <= 600
        && (!('ficheId' in data) || (data.ficheId is string && data.ficheId.size() <= 128))
        && (!('ficheOwnerId' in data) || (data.ficheOwnerId is string && data.ficheOwnerId.size() <= 128))
        && (!('numeroFiche' in data) || (data.numeroFiche is string && data.numeroFiche.size() <= 32))
        && (!('societe' in data) || (data.societe is string && data.societe.size() <= 200))
        && (!('payoutStatus' in data) || isValidPayoutStatus(data.payoutStatus))
        && (!('payoutMad' in data) || (data.payoutMad is number && data.payoutMad >= 0 && data.payoutMad <= 10000000))
        && (!('targetTab' in data) || isValidNotificationTab(data.targetTab))
        && data.read is bool
        && data.createdAtIso is string && data.createdAtIso.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFicheAuditLog(data, userId, ficheId, logId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'ficheId', 'action', 'summary',
          'actorUid', 'actorName', 'createdAtIso', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'ficheId', 'action', 'field', 'oldValue', 'newValue',
          'summary', 'actorUid', 'actorName', 'actorRole', 'createdAtIso',
          'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == logId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)
        && data.ficheId is string && data.ficheId == ficheId && isValidId(data.ficheId)
        && isValidAuditAction(data.action)
        && (!('field' in data) || (data.field is string && data.field.size() <= 80))
        && (!('oldValue' in data) || (data.oldValue is string && data.oldValue.size() <= 300))
        && (!('newValue' in data) || (data.newValue is string && data.newValue.size() <= 300))
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 600
        && data.actorUid is string && isValidId(data.actorUid)
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 120
        && (!('actorRole' in data) || (data.actorRole is string && data.actorRole.size() <= 40))
        && data.createdAtIso is string && data.createdAtIso.size() <= 64
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidDirectChatChannel(data, collabUid) {
      return data.keys().hasAll([
          'collabUid', 'orgScope', 'collabName', 'lastMessageText',
          'lastMessageAt', 'lastSenderUid', 'unreadByAdmin', 'unreadByCollab',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'collabUid', 'orgScope', 'collabName', 'collabEmail', 'collabZone',
          'lastMessageText', 'lastMessageAt', 'lastSenderUid', 'lastSenderName',
          'unreadByAdmin', 'unreadByCollab', 'createdAt', 'updatedAt'
        ])
        && data.collabUid is string && data.collabUid == collabUid && isValidId(data.collabUid)
        && data.orgScope is string && data.orgScope == 'orange_pro_team'
        && data.collabName is string && data.collabName.size() >= 1 && data.collabName.size() <= 120
        && (!('collabEmail' in data) || (data.collabEmail is string && data.collabEmail.size() <= 160))
        && (!('collabZone' in data) || (data.collabZone is string && data.collabZone.size() <= 100))
        && data.lastMessageText is string && data.lastMessageText.size() <= 500
        && data.lastMessageAt is string && data.lastMessageAt.size() <= 64
        && data.lastSenderUid is string && data.lastSenderUid.size() <= 128
        && (!('lastSenderName' in data) || (data.lastSenderName is string && data.lastSenderName.size() <= 120))
        && data.unreadByAdmin is number && data.unreadByAdmin >= 0 && data.unreadByAdmin <= 10000
        && data.unreadByCollab is number && data.unreadByCollab >= 0 && data.unreadByCollab <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDirectChatMessage(data, collabUid, messageId) {
      return data.keys().hasAll([
          'id', 'collabUid', 'orgScope', 'senderUid', 'senderName',
          'text', 'createdAtIso', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'collabUid', 'orgScope', 'senderUid', 'senderName', 'senderRole',
          'text', 'createdAtIso', 'createdAt'
        ])
        && data.id is string && data.id == messageId && isValidId(data.id)
        && data.collabUid is string && data.collabUid == collabUid && isValidId(data.collabUid)
        && data.orgScope is string && data.orgScope == 'orange_pro_team'
        && data.senderUid is string && isValidId(data.senderUid)
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 120
        && (!('senderRole' in data) || (data.senderRole is string && data.senderRole.size() <= 40))
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 2000
        && data.createdAtIso is string && data.createdAtIso.size() <= 64
        && data.createdAt is timestamp;
    }

    function isValidCoachingSession(data, collabUid) {
      return data.keys().hasAll([
          'collabUid', 'orgScope', 'collabName', 'collabConsentActive',
          'status', 'updatedAtIso', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'collabUid', 'orgScope', 'collabName', 'collabConsentActive',
          'status', 'adminUid', 'adminName', 'adminPttActive',
          'offerSdp', 'answerSdp', 'startedAtIso', 'updatedAtIso',
          'createdAt', 'updatedAt'
        ])
        && data.collabUid is string && data.collabUid == collabUid && isValidId(data.collabUid)
        && data.orgScope is string && data.orgScope == 'orange_pro_team'
        && data.collabName is string && data.collabName.size() >= 1 && data.collabName.size() <= 120
        && data.collabConsentActive is bool
        && isValidCoachingStatus(data.status)
        && (!('adminUid' in data) || (data.adminUid is string && data.adminUid.size() <= 128))
        && (!('adminName' in data) || (data.adminName is string && data.adminName.size() <= 120))
        && (!('adminPttActive' in data) || data.adminPttActive is bool)
        && (!('offerSdp' in data) || (data.offerSdp is string && data.offerSdp.size() <= 24000))
        && (!('answerSdp' in data) || (data.answerSdp is string && data.answerSdp.size() <= 24000))
        && (!('startedAtIso' in data) || (data.startedAtIso is string && data.startedAtIso.size() <= 64))
        && data.updatedAtIso is string && data.updatedAtIso.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCoachingCandidate(data, candId) {
      return data.keys().hasAll([
          'id', 'senderUid', 'fromRole', 'candidateJson', 'createdAtIso', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'senderUid', 'fromRole', 'candidateJson', 'createdAtIso', 'createdAt'
        ])
        && data.id is string && data.id == candId && isValidId(data.id)
        && data.senderUid is string && isValidId(data.senderUid)
        && data.fromRole is string && data.fromRole in ['collab', 'admin']
        && data.candidateJson is string && data.candidateJson.size() >= 1 && data.candidateJson.size() <= 4000
        && data.createdAtIso is string && data.createdAtIso.size() <= 64
        && data.createdAt is timestamp;
    }

    function isValidEmailSkill(data, userId, skillId) {
      return data.keys().hasAll([
          'ownerId', 'id', 'nom', 'description', 'role', 'regles', 'ctaStyle',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'id', 'nom', 'description', 'role', 'regles', 'ctaStyle',
          'isBuiltin', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.id is string
        && data.id == skillId
        && isValidId(data.id)
        && data.nom is string && data.nom.size() >= 1 && data.nom.size() <= 120
        && data.description is string && data.description.size() <= 300
        && data.role is string && data.role.size() <= 200
        && data.regles is string && data.regles.size() <= 4000
        && data.ctaStyle is string && data.ctaStyle.size() <= 300
        && (!('isBuiltin' in data) || (data.isBuiltin is bool))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Collection: /api_keys/{provider} (Super-Admin-Only Cloud API Keys Vault — Client Read/Write Strictly Denied)
    match /api_keys/{provider} {
      allow read, write: if false;
    }

    // 5. Collection: /app_users/{userId} (Admin-Managed Authorized Users Directory)
    match /app_users/{userId} {
      // Super-Admin can inspect any user; a signed-in user can only check their own authorization doc.
      allow get: if isValidId(userId) && (
        isSuperAdmin()
        || (isSignedIn() && request.auth.uid == userId && (resource == null || existing().uid == request.auth.uid))
      );

      // Strictly Super-Admin only; query MUST filter by createdBy == request.auth.uid (no get()/exists() in list).
      allow list: if isSuperAdmin() && resource.data.createdBy == request.auth.uid;

      allow create: if isSuperAdmin()
        && isValidId(userId)
        && isValidAppUser(incoming(), userId)
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSuperAdmin()
        && isValidId(userId)
        && isValidAppUser(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Admin updates user profile, role, zone, or active status
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'role', 'zone', 'active', 'updatedAt'
          ])
        );

      allow delete: if isSuperAdmin() && isValidId(userId);
    }

    // 6. Collection: /team_stats/{userId} (Non-PII Team Leaderboard, XP, Badges & Monthly Trends)
    match /team_stats/{userId} {
      allow get: if isValidId(userId)
        && (isSuperAdmin() || isApprovedMember(request.auth.uid))
        && (resource == null || existing().orgScope == 'orange_pro_team');

      // Query requires active approved member or Super-Admin and orgScope == 'orange_pro_team'.
      allow list: if (isSuperAdmin() || isApprovedMember(request.auth.uid))
        && resource.data.orgScope == 'orange_pro_team';

      allow create: if isValidId(userId)
        && isValidTeamStat(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isSuperAdmin()
          || (
            isApprovedMember(userId)
            && incoming().uid == request.auth.uid
            && incoming().xp == 0
            && incoming().totalContracts == 0
            && incoming().totalPayoutMad == 0
            && incoming().unlockedCount == 0
            && incoming().totalProspects == 0
            && incoming().totalQualified == 0
            && incoming().manualBadges.size() == 0
            && incoming().role == get(/databases/$(database)/documents/app_users/$(userId)).data.role
            && incoming().active == true
          )
        );

      allow update: if isValidId(userId)
        && isValidTeamStat(incoming(), userId)
        && (
          ('createdAt' in existing() && existing().createdAt is timestamp && incoming().createdAt == existing().createdAt)
          || incoming().createdAt == request.time
        )
        && incoming().updatedAt == request.time
        && (
          // Action 1: Super-Admin awards manual badges or updates/repairs any team stat fields (including legacy doc self-heal)
          (
            isSuperAdmin()
            && (!('uid' in existing()) || !(existing().uid is string) || existing().uid == '' || incoming().uid == existing().uid)
            && (!('orgScope' in existing()) || !(existing().orgScope is string) || existing().orgScope != 'orange_pro_team' || incoming().orgScope == existing().orgScope)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'uid', 'orgScope', 'displayName', 'role', 'zone', 'active', 'avatarDataUrl',
              'totalProspects', 'totalQualified', 'totalContracts', 'totalPayoutMad',
              'xp', 'unlockedCount', 'manualBadges', 'monthlyHistory', 'createdAt', 'updatedAt'
            ])
          )
          ||
          // Action 2: Collaborator updates own profile & non-financial progression stats (cannot alter financial counters, manual badges, role, or active)
          (
            isOwner(userId)
            && incoming().uid == request.auth.uid
            && existing().uid == request.auth.uid
            && existing().orgScope == 'orange_pro_team'
            && existing().createdAt is timestamp
            && incoming().createdAt == existing().createdAt
            && incoming().manualBadges == existing().manualBadges
            && incoming().role == existing().role
            && incoming().active == existing().active
            && incoming().totalContracts == existing().totalContracts
            && incoming().totalPayoutMad == existing().totalPayoutMad
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'zone', 'avatarDataUrl',
              'totalProspects', 'totalQualified', 'xp', 'unlockedCount', 'monthlyHistory',
              'updatedAt'
            ])
          )
        );

      allow delete: if isSuperAdmin() && isValidId(userId);
    }

    // 7. Collection: /signed_contracts/{contractId} (Signed Contracts & Commission Payout Ledger — No Client PII)
    match /signed_contracts/{contractId} {
      allow get: if isValidId(contractId) && (
        isSuperAdmin()
        || (isTeamLeadOrManager() && (resource == null || existing().orgScope == 'orange_pro_team'))
        || (isApprovedMember(request.auth.uid) && (resource == null || existing().ownerId == request.auth.uid))
      );

      // Super-Admin and Manager/Team-Lead list team contracts; active collaborators list ONLY their own.
      allow list: if (isSuperAdmin() && resource.data.orgScope == 'orange_pro_team')
        || (isTeamLeadOrManager() && resource.data.orgScope == 'orange_pro_team')
        || (isApprovedMember(request.auth.uid) && resource.data.ownerId == request.auth.uid);

      allow create: if isValidId(contractId)
        && isValidSignedContract(incoming(), contractId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          incoming().payoutStatus != 'Versé'
          || (
            'referenceVirement' in incoming()
            && incoming().referenceVirement is string
            && incoming().referenceVirement.size() >= 1
            && incoming().referenceVirement.size() <= 80
          )
        )
        && (
          incoming().payoutStatus != 'Refusé'
          || (
            'refusMotif' in incoming()
            && incoming().refusMotif is string
            && incoming().refusMotif.size() >= 1
            && incoming().refusMotif.size() <= 200
          )
        )
        && (
          isSuperAdmin()
          || isTeamLeadOrManager()
          || (
            incoming().payoutMad == 0
            && incoming().payoutStatus == 'En attente'
            && isApprovedMember(request.auth.uid)
            && incoming().ownerId == request.auth.uid
          )
        );

      // Tier 1: Super-Admin, Managers and Team Leads manage payouts, products, and statuses.
      // Tier 2: Approved contract owner may refine produitOrangePro/tier ONLY while payoutStatus == 'En attente'.
      // Immutable identity/client/timestamp fields cannot be modified.
      // Transition to 'Versé' strictly requires a non-empty referenceVirement (max 80).
      // Transition to 'Refusé' strictly requires a non-empty refusMotif (max 200).
      allow update: if isValidId(contractId)
        && incoming().updatedAt == request.time
        && (!('id' in existing()) || incoming().id == existing().id)
        && (!('orgScope' in existing()) || incoming().orgScope == existing().orgScope)
        && (!('ownerId' in existing()) || incoming().ownerId == existing().ownerId)
        && (!('ficheId' in existing()) || incoming().ficheId == existing().ficheId)
        && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt)
        && incoming().produitOrangePro is string
        && incoming().produitOrangePro.size() >= 1
        && incoming().produitOrangePro.size() <= 200
        && isValidOrangeTier(incoming().tier)
        && (
          // Tier 1: Supervisors (Super-Admin / Manager / Team-Lead)
          (
            (isSuperAdmin() || isTeamLeadOrManager())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'produitOrangePro', 'tier', 'payoutMad', 'payoutStatus',
              'referenceVirement', 'refusMotif', 'updatedAt'
            ])
            && incoming().payoutMad is number
            && incoming().payoutMad >= 0
            && incoming().payoutMad <= 10000000
            && isValidPayoutStatus(incoming().payoutStatus)
            && (
              !('referenceVirement' in incoming())
              || (incoming().referenceVirement is string && incoming().referenceVirement.size() <= 80)
            )
            && (
              !('refusMotif' in incoming())
              || (incoming().refusMotif is string && incoming().refusMotif.size() <= 200)
            )
            && (
              incoming().payoutStatus != 'Versé'
              || (
                'referenceVirement' in incoming()
                && incoming().referenceVirement is string
                && incoming().referenceVirement.size() >= 1
                && incoming().referenceVirement.size() <= 80
              )
            )
            && (
              incoming().payoutStatus != 'Refusé'
              || (
                'refusMotif' in incoming()
                && incoming().refusMotif is string
                && incoming().refusMotif.size() >= 1
                && incoming().refusMotif.size() <= 200
              )
            )
          )
          ||
          // Tier 2: Approved contract owner updating ONLY product/tier on their own pending contract
          (
            isApprovedMember(request.auth.uid)
            && existing().ownerId == request.auth.uid
            && existing().payoutStatus == 'En attente'
            && incoming().payoutMad == existing().payoutMad
            && incoming().payoutStatus == existing().payoutStatus
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'produitOrangePro', 'tier', 'updatedAt'
            ])
          )
        );

      allow delete: if isSuperAdmin() && isValidId(contractId);
    }

    // 8. Collection: /user_presence/{userId} (PII Profile, Devices & Work-Hours Attendance — Owner & Super-Admin ONLY)
    match /user_presence/{userId} {
      allow get: if isValidId(userId) && (
        isSuperAdmin()
        || (isOwner(userId) && (resource == null || existing().uid == request.auth.uid))
      );

      // Strictly Super-Admin only; query MUST filter by orgScope == 'orange_pro_team'.
      allow list: if isSuperAdmin() && resource.data.orgScope == 'orange_pro_team';

      allow create: if isValidId(userId)
        && isValidUserPresence(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isSuperAdmin()
          || (
            isOwner(userId)
            && incoming().uid == request.auth.uid
            && incoming().role == get(/databases/$(database)/documents/app_users/$(userId)).data.role
          )
        );

      allow update: if isValidId(userId)
        && isValidUserPresence(incoming(), userId)
        && (
          ('createdAt' in existing() && existing().createdAt is timestamp && incoming().createdAt == existing().createdAt)
          || incoming().createdAt == request.time
        )
        && incoming().updatedAt == request.time
        && (
          // Action 1: Super-Admin updates collaborator profile metadata or own presence (including legacy doc self-heal)
          (
            isSuperAdmin()
            && (!('uid' in existing()) || !(existing().uid is string) || existing().uid == '' || incoming().uid == existing().uid)
            && (!('orgScope' in existing()) || !(existing().orgScope is string) || existing().orgScope != 'orange_pro_team' || incoming().orgScope == existing().orgScope)
            && (!('email' in existing()) || !(existing().email is string) || existing().email.size() < 3 || incoming().email.lower() == existing().email.lower() || userId == request.auth.uid)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'uid', 'orgScope', 'email', 'displayName', 'firstName', 'lastName', 'phonePro', 'avatarDataUrl',
              'role', 'zone', 'isOnline', 'currentDevice', 'devicesUsed',
              'lastLoginAt', 'lastLogoutAt', 'lastSeenAt', 'lastWorkDisconnectAt',
              'workHoursDisconnectCount', 'workHoursDisconnectTimes',
              'activeDateKey', 'todayWorkedSeconds', 'totalWorkedSeconds',
              'currentSessionId', 'createdAt', 'updatedAt'
            ])
          )
          ||
          // Action 2: Collaborator updates own profile, device list, and live attendance status (role & email strictly bound)
          (
            isOwner(userId)
            && incoming().uid == request.auth.uid
            && (!('uid' in existing()) || !(existing().uid is string) || existing().uid == '' || incoming().uid == existing().uid)
            && (!('orgScope' in existing()) || !(existing().orgScope is string) || existing().orgScope != 'orange_pro_team' || incoming().orgScope == existing().orgScope)
            && (
              (('email' in existing()) && existing().email is string && existing().email.size() >= 3 && incoming().email.lower() == existing().email.lower())
              || (
                (!('email' in existing()) || !(existing().email is string) || existing().email.size() < 3)
                && request.auth.token.email is string
                && incoming().email.lower() == request.auth.token.email.lower()
              )
            )
            && (
              !('role' in existing())
              || incoming().role == existing().role
              || incoming().role == get(/databases/$(database)/documents/app_users/$(userId)).data.role
            )
            && (
              (
                'activeDateKey' in existing()
                && 'todayWorkedSeconds' in existing()
                && existing().activeDateKey is string
                && existing().todayWorkedSeconds is number
                && existing().todayWorkedSeconds >= 0
                && existing().todayWorkedSeconds <= 86400
                && incoming().activeDateKey == existing().activeDateKey
                && incoming().todayWorkedSeconds >= existing().todayWorkedSeconds
                && incoming().todayWorkedSeconds <= existing().todayWorkedSeconds + 600
              )
              || (
                (
                  !('activeDateKey' in existing())
                  || !('todayWorkedSeconds' in existing())
                  || !(existing().activeDateKey is string)
                  || !(existing().todayWorkedSeconds is number)
                  || existing().todayWorkedSeconds < 0
                  || existing().todayWorkedSeconds > 86400
                  || incoming().activeDateKey != existing().activeDateKey
                )
                && incoming().todayWorkedSeconds >= 0
                && incoming().todayWorkedSeconds <= 600
              )
            )
            && incoming().todayWorkedSeconds <= 86400
            && (
              !('totalWorkedSeconds' in existing())
              || !(existing().totalWorkedSeconds is number)
              || existing().totalWorkedSeconds < 0
              || existing().totalWorkedSeconds > 100000000
              || (
                incoming().totalWorkedSeconds >= existing().totalWorkedSeconds
                && incoming().totalWorkedSeconds <= existing().totalWorkedSeconds + 600
              )
            )
            && (
              incoming().diff(existing()).affectedKeys().hasOnly([
                'uid', 'orgScope', 'email', 'displayName', 'firstName', 'lastName', 'phonePro', 'avatarDataUrl',
                'zone', 'isOnline', 'currentDevice', 'devicesUsed',
                'lastLoginAt', 'lastLogoutAt', 'lastSeenAt', 'lastWorkDisconnectAt',
                'workHoursDisconnectCount', 'workHoursDisconnectTimes',
                'activeDateKey', 'todayWorkedSeconds', 'totalWorkedSeconds',
                'currentSessionId', 'createdAt', 'updatedAt'
              ])
              || (
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'uid', 'orgScope', 'email', 'displayName', 'firstName', 'lastName', 'phonePro', 'avatarDataUrl',
                  'role', 'zone', 'isOnline', 'currentDevice', 'devicesUsed',
                  'lastLoginAt', 'lastLogoutAt', 'lastSeenAt', 'lastWorkDisconnectAt',
                  'workHoursDisconnectCount', 'workHoursDisconnectTimes',
                  'activeDateKey', 'todayWorkedSeconds', 'totalWorkedSeconds',
                  'currentSessionId', 'createdAt', 'updatedAt'
                ])
                && incoming().role == get(/databases/$(database)/documents/app_users/$(userId)).data.role
              )
            )
          )
        );

      allow delete: if isSuperAdmin() && isValidId(userId);

      // 8b. Subcollection: /user_presence/{userId}/sessions/{sessionId} (Login/Logout & Work-Hours Sessions)
      match /sessions/{sessionId} {
        allow get: if isValidId(userId) && isValidId(sessionId) && (
          isSuperAdmin()
          || (isOwner(userId) && (resource == null || existing().ownerId == request.auth.uid))
        );

        allow list: if (isSuperAdmin() && resource.data.orgScope == 'orange_pro_team')
          || (isOwner(userId) && resource.data.ownerId == request.auth.uid);

        allow create: if isValidId(userId)
          && isValidId(sessionId)
          && isValidAttendanceSession(incoming(), userId, sessionId)
          && isOwner(userId)
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/user_presence/$(userId));

        allow update: if isValidId(userId)
          && isValidId(sessionId)
          && isValidAttendanceSession(incoming(), userId, sessionId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid
          && incoming().ownerId == existing().ownerId
          && incoming().id == existing().id
          && incoming().orgScope == existing().orgScope
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/user_presence/$(userId))
          && (
            // Action: Heartbeat or session closure (login/logout/disconnect)
            incoming().diff(existing()).affectedKeys().hasOnly([
              'lastSeenAt', 'logoutAt', 'workedSeconds', 'status',
              'disconnectReason', 'disconnectedDuringWorkHours', 'updatedAt'
            ])
          );

        allow delete: if isSuperAdmin() && isValidId(userId) && isValidId(sessionId);
      }
    }

    // 9. Collection: /users/{userId} (Workspace Settings)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId)
        && (resource == null || existing().ownerId == request.auth.uid);
      allow list: if false;

      allow create: if isValidId(userId)
        && isValidUserWorkspaceConfig(incoming(), userId)
        && isOwner(userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isValidUserWorkspaceConfig(incoming(), userId)
        && isOwner(userId)
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Update workspace & personal profile settings (cities, signature, photo, preferences, dedup choices, legal info)
          incoming().diff(existing()).affectedKeys().hasOnly([
            'villesAll', 'villesActive', 'modeVille', 'defaultVille',
            'emailSignature', 'seeded', 'displayName', 'avatarDataUrl',
            'phonePro', 'zone', 'bio', 'monthlyGoalContracts',
            'notifyBadges', 'notifySound', 'compactUi',
            'dismissedDedupKeys', 'includePhoneOnlyDedup',
            'legalRaisonSociale', 'legalIce', 'legalAdresse', 'legalTelephone',
            'updatedAt'
          ])
        );

      allow delete: if isValidId(userId) && isOwner(userId) && existing().ownerId == request.auth.uid;

      // 10. Subcollection: /users/{userId}/fiches/{ficheId} (B2B CRM Prospects — Locked after Signing for Collaborators)
      match /fiches/{ficheId} {
        allow get: if isValidId(userId) && isValidId(ficheId) && (
          (isOwner(userId) && (resource == null || existing().ownerId == request.auth.uid))
          || ((isSuperAdmin() || isTeamLeadOrManager()) && (resource == null || existing().ownerId == userId))
        );

        allow list: if (isOwner(userId) && resource.data.ownerId == request.auth.uid)
          || (canSuperviseTeam() && resource.data.ownerId == userId);

        allow create: if isValidId(userId)
          && isValidId(ficheId)
          && isValidFicheEntreprise(incoming(), userId, ficheId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (
            (isOwner(userId) && incoming().ownerId == request.auth.uid && exists(/databases/$(database)/documents/users/$(userId)))
            || ((isSuperAdmin() || isTeamLeadOrManager()) && incoming().ownerId == userId
              && (exists(/databases/$(database)/documents/users/$(userId)) || exists(/databases/$(database)/documents/app_users/$(userId))))
          );

        allow update: if isValidId(userId)
          && isValidId(ficheId)
          && isValidFicheEntreprise(incoming(), userId, ficheId)
          && incoming().ownerId == existing().ownerId
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (
              isOwner(userId)
              && existing().ownerId == request.auth.uid
              && (isSuperAdmin() || existing().statut != 'Signé Orange Pro')
              && exists(/databases/$(database)/documents/users/$(userId))
            )
            || (
              (isSuperAdmin() || isTeamLeadOrManager())
              && existing().ownerId == userId
            )
          )
          && (
            // Action 1: Kanban pipeline status transition or reminder mirror update
            incoming().diff(existing()).affectedKeys().hasOnly([
              'statut', 'statutUpdatedAt', 'prochaineRelanceAt', 'rdvAt', 'rdvLieu', 'updatedAt'
            ])
            ||
            // Action 2: Full CRM edit, multi-contact addition, web/AI enrichment, attribution, or signed fiche restoration
            incoming().diff(existing()).affectedKeys().hasOnly([
              'numeroFiche', 'societe', 'secteur', 'ville', 'telephone',
              'telephonesSupplementaires', 'email', 'emailsSupplementaires',
              'contact', 'role', 'source', 'effectif', 'statut', 'statutUpdatedAt',
              'siteWeb', 'verifieWeb', 'pistesEnrichissement',
              'prochaineRelanceAt', 'rdvAt', 'rdvLieu',
              'assignedByUid', 'assignedByName', 'assignedAt',
              'restoredByName', 'restoredAt', 'restoredReason',
              'dateAjout', 'updatedAt'
            ])
          );

        allow delete: if isValidId(userId)
          && isValidId(ficheId)
          && (
            (
              isOwner(userId)
              && existing().ownerId == request.auth.uid
              && (isSuperAdmin() || existing().statut != 'Signé Orange Pro')
              && exists(/databases/$(database)/documents/users/$(userId))
            )
            || (
              (isSuperAdmin() || isTeamLeadOrManager())
              && existing().ownerId == userId
            )
          );

        // 10b. Subcollection: /users/{userId}/fiches/{ficheId}/activites/{activiteId} (Activity Journal, Audit Trail, RDV & Relance)
        match /activites/{activiteId} {
          allow get: if isValidId(userId) && isValidId(ficheId) && isValidId(activiteId) && (
            (isOwner(userId) && (resource == null || existing().ownerId == request.auth.uid))
            || ((isSuperAdmin() || isTeamLeadOrManager()) && (resource == null || existing().ownerId == userId))
          );

          allow list: if (isOwner(userId) && resource.data.ownerId == request.auth.uid)
            || (canSuperviseTeam() && resource.data.ownerId == userId);

          allow create: if isValidId(userId)
            && isValidId(ficheId)
            && isValidId(activiteId)
            && isValidFicheActivite(incoming(), userId, ficheId, activiteId)
            && incoming().ficheId == ficheId
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time
            && exists(/databases/$(database)/documents/users/$(userId)/fiches/$(ficheId))
            && (
              (isOwner(userId) && incoming().ownerId == request.auth.uid)
              || ((isSuperAdmin() || isTeamLeadOrManager()) && incoming().ownerId == userId)
            );

          allow update: if isValidId(userId)
            && isValidId(ficheId)
            && isValidId(activiteId)
            && isValidFicheActivite(incoming(), userId, ficheId, activiteId)
            && incoming().ownerId == existing().ownerId
            && incoming().ficheId == existing().ficheId
            && incoming().id == existing().id
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && exists(/databases/$(database)/documents/users/$(userId)/fiches/$(ficheId))
            && (
              (isOwner(userId) && existing().ownerId == request.auth.uid)
              || ((isSuperAdmin() || isTeamLeadOrManager()) && existing().ownerId == userId)
            )
            && (
              incoming().diff(existing()).affectedKeys().hasOnly([
                'type', 'resultat', 'texte', 'auteurNom', 'auteurUid', 'auteurRole',
                'createdAtIso', 'rdvAt', 'rdvLieu', 'prochaineRelanceAt', 'updatedAt'
              ])
            );

          allow delete: if isValidId(userId)
            && isValidId(ficheId)
            && isValidId(activiteId)
            && (isSuperAdmin() || isTeamLeadOrManager() || (isOwner(userId) && existing().ownerId == request.auth.uid))
            && exists(/databases/$(database)/documents/users/$(userId)/fiches/$(ficheId));
        }

        // 10c. Subcollection: /users/{userId}/fiches/{ficheId}/audit_logs/{logId} (Immutable Modification Audit Log)
        match /audit_logs/{logId} {
          allow get: if isValidId(userId) && isValidId(ficheId) && isValidId(logId) && (
            (isOwner(userId) && (resource == null || existing().ownerId == request.auth.uid))
            || ((isSuperAdmin() || isTeamLeadOrManager()) && (resource == null || existing().ownerId == userId))
          );

          allow list: if (isOwner(userId) && resource.data.ownerId == request.auth.uid)
            || (canSuperviseTeam() && resource.data.ownerId == userId);

          allow create: if isValidId(userId)
            && isValidId(ficheId)
            && isValidId(logId)
            && isValidFicheAuditLog(incoming(), userId, ficheId, logId)
            && incoming().createdAt == request.time
            && (!('updatedAt' in incoming()) || incoming().updatedAt == request.time)
            && exists(/databases/$(database)/documents/users/$(userId)/fiches/$(ficheId))
            && (
              (isOwner(userId) && incoming().ownerId == request.auth.uid && incoming().actorUid == request.auth.uid)
              || ((isSuperAdmin() || isTeamLeadOrManager()) && incoming().ownerId == userId)
            );

          // Audit logs are strictly append-only (immutable)
          allow update: if false;

          allow delete: if isSuperAdmin() && isValidId(userId) && isValidId(ficheId) && isValidId(logId);
        }
      }

      // 11. Subcollection: /users/{userId}/skills/{skillId} (Email Studio Skills)
      match /skills/{skillId} {
        allow get: if isValidId(userId) && isValidId(skillId) && isOwner(userId)
          && (resource == null || existing().ownerId == request.auth.uid);

        allow list: if isOwner(userId)
          && resource.data.ownerId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(skillId)
          && isValidEmailSkill(incoming(), userId, skillId)
          && isOwner(userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isValidId(userId)
          && isValidId(skillId)
          && isValidEmailSkill(incoming(), userId, skillId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid
          && incoming().ownerId == existing().ownerId
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && (
            // Action: Edit skill metadata and rules
            incoming().diff(existing()).affectedKeys().hasOnly([
              'nom', 'description', 'role', 'regles', 'ctaStyle', 'isBuiltin', 'updatedAt'
            ])
          );

        allow delete: if isValidId(userId)
          && isValidId(skillId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid
          && exists(/databases/$(database)/documents/users/$(userId));
      }
    }

    // 12. Collection: /notifications/{notifId} (Real-time Cross-User Notifications: Fiche Assignment, Access, Restoration)
    match /notifications/{notifId} {
      allow get: if isValidId(notifId)
        && (isSuperAdmin() || (isApprovedMember(request.auth.uid) && (resource == null || existing().recipientUid == request.auth.uid)));

      allow list: if (isSuperAdmin() || isApprovedMember(request.auth.uid))
        && resource.data.recipientUid == request.auth.uid;

      allow create: if isValidId(notifId)
        && isValidAppNotification(incoming(), notifId)
        && (isSuperAdmin() || isApprovedMember(request.auth.uid))
        && incoming().senderUid == request.auth.uid
        && incoming().read == false
        && (!(incoming().kind in ['fiche_assigned', 'fiche_restored', 'contract_status_changed', 'coaching_invite']) || canSuperviseTeam())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(notifId)
        && isValidAppNotification(incoming(), notifId)
        && (isSuperAdmin() || isApprovedMember(request.auth.uid))
        && existing().recipientUid == request.auth.uid
        && incoming().id == existing().id
        && incoming().recipientUid == existing().recipientUid
        && incoming().senderUid == existing().senderUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt']);

      allow delete: if isValidId(notifId)
        && (isSuperAdmin() || (isApprovedMember(request.auth.uid) && existing().recipientUid == request.auth.uid));
    }

    // 13. Collection: /direct_chats/{collabUid} (Private 1-to-1 Discussion Channel: Super-Admin <-> Collaborator)
    match /direct_chats/{collabUid} {
      allow get: if isValidId(collabUid) && (
        isSuperAdmin()
        || (isOwner(collabUid) && (resource == null || existing().collabUid == request.auth.uid))
      );

      allow list: if (isSuperAdmin() && resource.data.orgScope == 'orange_pro_team')
        || (isOwner(collabUid) && resource.data.collabUid == request.auth.uid);

      allow create: if isValidId(collabUid)
        && isValidDirectChatChannel(incoming(), collabUid)
        && (isSuperAdmin() || isOwner(collabUid))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(collabUid)
        && isValidDirectChatChannel(incoming(), collabUid)
        && (isSuperAdmin() || (isOwner(collabUid) && existing().collabUid == request.auth.uid))
        && (!('collabUid' in existing()) || incoming().collabUid == existing().collabUid)
        && (!('orgScope' in existing()) || incoming().orgScope == existing().orgScope)
        && (
          ('createdAt' in existing() && existing().createdAt is timestamp && incoming().createdAt == existing().createdAt)
          || ((!('createdAt' in existing()) || !(existing().createdAt is timestamp)) && incoming().createdAt == request.time)
        )
        && incoming().updatedAt == request.time
        && (
          isSuperAdmin()
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'collabName', 'collabEmail', 'collabZone', 'lastMessageText',
            'lastMessageAt', 'lastSenderUid', 'lastSenderName',
            'unreadByAdmin', 'unreadByCollab', 'updatedAt'
          ])
        );

      allow delete: if isSuperAdmin() && isValidId(collabUid);

      // 13b. Subcollection: /direct_chats/{collabUid}/messages/{messageId}
      match /messages/{messageId} {
        allow get: if isValidId(collabUid) && isValidId(messageId) && (
          isSuperAdmin()
          || (isOwner(collabUid) && (resource == null || existing().collabUid == request.auth.uid))
        );

        allow list: if (isSuperAdmin() && resource.data.orgScope == 'orange_pro_team')
          || (isOwner(collabUid) && resource.data.collabUid == request.auth.uid);

        allow create: if isValidId(collabUid)
          && isValidId(messageId)
          && isValidDirectChatMessage(incoming(), collabUid, messageId)
          && (isSuperAdmin() || isOwner(collabUid))
          && incoming().senderUid == request.auth.uid
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/direct_chats/$(collabUid));

        // Direct chat messages are strictly immutable append-only
        allow update: if false;

        allow delete: if isSuperAdmin() && isValidId(collabUid) && isValidId(messageId);
      }
    }

    // 14. Collection: /coaching_sessions/{collabUid} (Transparent Opt-In Field Coaching & Push-to-Talk Audio — WebRTC P2P)
    match /coaching_sessions/{collabUid} {
      allow get: if isValidId(collabUid) && (
        isSuperAdmin()
        || (isOwner(collabUid) && (resource == null || existing().collabUid == request.auth.uid))
      );

      allow list: if (isSuperAdmin() && resource.data.orgScope == 'orange_pro_team')
        || (isOwner(collabUid) && resource.data.collabUid == request.auth.uid);

      // Only the collaborator themselves can opt-in (collabConsentActive == true); Super-Admin can only initialize idle/ended doc with consent false.
      allow create: if isValidId(collabUid)
        && isValidCoachingSession(incoming(), collabUid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isOwner(collabUid)
          || (isSuperAdmin() && incoming().collabConsentActive == false)
        );

      allow update: if isValidId(collabUid)
        && isValidCoachingSession(incoming(), collabUid)
        && incoming().collabUid == existing().collabUid
        && incoming().orgScope == existing().orgScope
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Collaborator controls own consent, WebRTC offer, and status
          (
            isOwner(collabUid)
            && existing().collabUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'collabName', 'collabConsentActive', 'status', 'offerSdp',
              'answerSdp', 'adminPttActive', 'startedAtIso', 'updatedAtIso', 'updatedAt'
            ])
          )
          ||
          // Super-Admin can join/answer/Push-to-Talk ONLY while collaborator consent is active (cannot force collabConsentActive true)
          (
            isSuperAdmin()
            && existing().collabConsentActive == true
            && incoming().collabConsentActive == existing().collabConsentActive
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'adminUid', 'adminName', 'adminPttActive',
              'answerSdp', 'updatedAtIso', 'updatedAt'
            ])
          )
        );

      allow delete: if isSuperAdmin() && isValidId(collabUid);

      // 14b. Subcollection: /coaching_sessions/{collabUid}/candidates/{candId} (WebRTC ICE Candidates)
      match /candidates/{candId} {
        allow get: if isValidId(collabUid) && isValidId(candId) && (
          isSuperAdmin() || isOwner(collabUid)
        );

        allow list: if isValidId(collabUid) && (
          isSuperAdmin()
          || isOwner(collabUid)
        );

        allow create: if isValidId(collabUid)
          && isValidId(candId)
          && isValidCoachingCandidate(incoming(), candId)
          && incoming().senderUid == request.auth.uid
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/coaching_sessions/$(collabUid))
          && (
            (isSuperAdmin() && incoming().fromRole == 'admin')
            || (isOwner(collabUid) && incoming().fromRole == 'collab')
          );

        allow update: if false;

        allow delete: if isValidId(collabUid)
          && isValidId(candId)
          && (isSuperAdmin() || isOwner(collabUid));
      }
    }
  }
}
