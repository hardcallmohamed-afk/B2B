rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    function isSuperAdmin() {
      return isVerifiedUser()
        && request.auth.token.email is string
        && request.auth.token.email == 'hardcallmohamed@gmail.com';
    }
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function isValidProviderId(id) {
      return id is string && id.size() >= 1 && id.size() <= 64 && id.matches('^[a-z0-9_\\-]+$');
    }
    function isValidNumeroFiche(val) {
      return val is string && val.size() >= 1 && val.size() <= 32 && val.matches('^[A-Z0-9_\\-]+$');
    }
    function isApprovedMember(userId) {
      return isVerifiedUser()
        && request.auth.uid == userId
        && exists(/databases/$(database)/documents/app_users/$(userId))
        && get(/databases/$(database)/documents/app_users/$(userId)).data.active == true;
    }
    function isOwner(userId) {
      return (isSuperAdmin() && request.auth.uid == userId) || isApprovedMember(userId);
    }

    function isValidSecteur(val) {
      return val is string && val in [
        'fiduciaire', 'clinique', 'notaire', 'immobilier', 'riad_hotellerie',
        'auto_ecole', 'pme', 'industrie', 'btp', 'gros', 'enseignement',
        'liberal', 'commerce'
      ];
    }

    function isValidStatut(val) {
      return val is string && val in [
        'À contacter', 'Appel en cours', 'RDV pris',
        'Devis envoyé', 'Signé Orange Pro', 'Pas intéressé'
      ];
    }

    function isValidManagedRole(val) {
      return val is string && val in ['commercial', 'grand_compte', 'team_lead', 'manager'];
    }

    function isValidTeamRole(val) {
      return val is string && val in ['super_admin', 'manager', 'team_lead', 'grand_compte', 'commercial'];
    }

    function isValidOrangeTier(val) {
      return val is string && val in ['Grand Compte', 'PME', 'TPE / Libéral'];
    }

    function isValidPayoutStatus(val) {
      return val is string && val in ['En attente', 'Validé', 'Versé', 'Refusé'];
    }

    function isValidDeviceType(val) {
      return val is string && val in ['desktop', 'mobile', 'tablet'];
    }

    function isValidSessionStatus(val) {
      return val is string && val in ['active', 'closed', 'disconnected_work_hours'];
    }

    function isManager() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/app_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/app_users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/app_users/$(request.auth.uid)).data.role == 'manager';
    }

    function isTeamLeadOrManager() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/app_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/app_users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/app_users/$(request.auth.uid)).data.role in ['manager', 'team_lead'];
    }

    function isValidActiviteType(val) {
      return val is string && val in [
        'appel', 'whatsapp', 'email', 'visite', 'note', 'rdv', 'devis', 'statut'
      ];
    }

    function isValidActiviteResultat(val) {
      return val is string && val in [
        'joint', 'pas_de_reponse', 'rappeler', 'rdv_fixe', 'refus', 'autre', 'vide'
      ];
    }

    function isValidStringList(arr, maxItems, maxItemLen) {
      return arr is list
        && arr.size() <= maxItems
        && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= maxItemLen))
        && (arr.size() <= 1 || (arr[1] is string && arr[1].size() <= maxItemLen))
        && (arr.size() <= 2 || (arr[2] is string && arr[2].size() <= maxItemLen))
        && (arr.size() <= 3 || (arr[3] is string && arr[3].size() <= maxItemLen))
        && (arr.size() <= 4 || (arr[4] is string && arr[4].size() <= maxItemLen))
        && (arr.size() <= 5 || (arr[5] is string && arr[5].size() <= maxItemLen))
        && (arr.size() <= 6 || (arr[6] is string && arr[6].size() <= maxItemLen))
        && (arr.size() <= 7 || (arr[7] is string && arr[7].size() <= maxItemLen))
        && (arr.size() <= 8 || (arr[8] is string && arr[8].size() <= maxItemLen))
        && (arr.size() <= 9 || (arr[9] is string && arr[9].size() <= maxItemLen))
        && (arr.size() <= 10 || (arr[10] is string && arr[10].size() <= maxItemLen))
        && (arr.size() <= 11 || (arr[11] is string && arr[11].size() <= maxItemLen))
        && (arr.size() <= 12 || (arr[12] is string && arr[12].size() <= maxItemLen))
        && (arr.size() <= 13 || (arr[13] is string && arr[13].size() <= maxItemLen))
        && (arr.size() <= 14 || (arr[14] is string && arr[14].size() <= maxItemLen))
        && (arr.size() <= 15 || (arr[15] is string && arr[15].size() <= maxItemLen))
        && (arr.size() <= 16 || (arr[16] is string && arr[16].size() <= maxItemLen))
        && (arr.size() <= 17 || (arr[17] is string && arr[17].size() <= maxItemLen))
        && (arr.size() <= 18 || (arr[18] is string && arr[18].size() <= maxItemLen))
        && (arr.size() <= 19 || (arr[19] is string && arr[19].size() <= maxItemLen));
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap)
    function isValidAppUser(data, targetUid) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'role', 'zone', 'active',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'role', 'zone', 'active',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.uid is string
        && data.uid == targetUid
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && isValidManagedRole(data.role)
        && data.zone is string && data.zone.size() <= 100
        && data.active is bool
        && data.createdBy is string
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidApiKeyConfig(data, provider) {
      return data.keys().hasAll([
          'provider', 'label', 'key', 'active', 'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'provider', 'label', 'key', 'active', 'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.provider is string
        && data.provider == provider
        && isValidProviderId(data.provider)
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 120
        && data.key is string && data.key.size() >= 1 && data.key.size() <= 512
        && data.active is bool
        && data.updatedBy is string
        && isValidId(data.updatedBy)
        && data.updatedBy == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAvatarDataUrl(val) {
      return val is string
        && val.size() <= 45000
        && (val.size() == 0 || val.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$'));
    }

    function isValidTeamStat(data, targetUid) {
      return data.keys().hasAll([
          'uid', 'orgScope', 'displayName', 'role', 'zone', 'active',
          'totalProspects', 'totalQualified', 'totalContracts', 'totalPayoutMad',
          'xp', 'unlockedCount', 'manualBadges', 'monthlyHistory',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'orgScope', 'displayName', 'role', 'zone', 'active',
          'totalProspects', 'totalQualified', 'totalContracts', 'totalPayoutMad',
          'xp', 'unlockedCount', 'manualBadges', 'monthlyHistory',
          'avatarDataUrl', 'createdAt', 'updatedAt'
        ])
        && data.uid is string
        && data.uid == targetUid
        && isValidId(data.uid)
        && data.orgScope is string && data.orgScope == 'orange_pro_team'
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && isValidTeamRole(data.role)
        && data.zone is string && data.zone.size() <= 100
        && data.active is bool
        && data.totalProspects is int && data.totalProspects >= 0 && data.totalProspects <= 100000
        && data.totalQualified is int && data.totalQualified >= 0 && data.totalQualified <= 100000
        && data.totalContracts is int && data.totalContracts >= 0 && data.totalContracts <= 100000
        && data.totalPayoutMad is number && data.totalPayoutMad >= 0 && data.totalPayoutMad <= 100000000
        && data.xp is int && data.xp >= 0 && data.xp <= 10000000
        && data.unlockedCount is int && data.unlockedCount >= 0 && data.unlockedCount <= 100
        && isValidStringList(data.manualBadges, 20, 64)
        && isValidStringList(data.monthlyHistory, 24, 40)
        && (!('avatarDataUrl' in data) || isValidAvatarDataUrl(data.avatarDataUrl))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSignedContract(data, contractId) {
      return data.keys().hasAll([
          'id', 'orgScope', 'ownerId', 'ownerName', 'ficheId', 'numeroFiche',
          'societe', 'ville', 'secteur', 'produitOrangePro', 'tier', 'effectif',
          'payoutMad', 'payoutStatus', 'signedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'orgScope', 'ownerId', 'ownerName', 'ficheId', 'numeroFiche',
          'societe', 'ville', 'secteur', 'produitOrangePro', 'tier', 'effectif',
          'payoutMad', 'payoutStatus', 'signedAt', 'referenceVirement', 'refusMotif', 'createdAt', 'updatedAt'
        ])
        && data.id is string
        && data.id == contractId
        && isValidId(data.id)
        && data.orgScope is string && data.orgScope == 'orange_pro_team'
        && data.ownerId is string && isValidId(data.ownerId)
        && data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 120
        && data.ficheId is string && isValidId(data.ficheId)
        && data.numeroFiche is string && data.numeroFiche.size() <= 32
        && data.societe is string && data.societe.size() >= 1 && data.societe.size() <= 200
        && data.ville is string && data.ville.size() <= 100
        && isValidSecteur(data.secteur)
        && data.produitOrangePro is string && data.produitOrangePro.size() >= 1 && data.produitOrangePro.size() <= 200
        && isValidOrangeTier(data.tier)
        && data.effectif is string && data.effectif.size() <= 20
        && data.payoutMad is number && data.payoutMad >= 0 && data.payoutMad <= 10000000
        && isValidPayoutStatus(data.payoutStatus)
        && data.signedAt is string && data.signedAt.size() <= 64
        && (!('referenceVirement' in data) || (data.referenceVirement is string && data.referenceVirement.size() <= 80))
        && (!('refusMotif' in data) || (data.refusMotif is string && data.refusMotif.size() <= 200))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPresence(data, targetUid) {
      return data.keys().hasAll([
          'uid', 'orgScope', 'email', 'displayName', 'firstName', 'lastName',
          'phonePro', 'avatarDataUrl', 'role', 'zone', 'isOnline',
          'currentDevice', 'devicesUsed', 'lastLoginAt', 'lastLogoutAt',
          'lastSeenAt', 'lastWorkDisconnectAt', 'workHoursDisconnectCount',
          'workHoursDisconnectTimes', 'activeDateKey', 'todayWorkedSeconds',
          'totalWorkedSeconds', 'currentSessionId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'orgScope', 'email', 'displayName', 'firstName', 'lastName',
          'phonePro', 'avatarDataUrl', 'role', 'zone', 'isOnline',
          'currentDevice', 'devicesUsed', 'lastLoginAt', 'lastLogoutAt',
          'lastSeenAt', 'lastWorkDisconnectAt', 'workHoursDisconnectCount',
          'workHoursDisconnectTimes', 'activeDateKey', 'todayWorkedSeconds',
          'totalWorkedSeconds', 'currentSessionId', 'createdAt', 'updatedAt'
        ])
        && data.uid is string
        && data.uid == targetUid
        && isValidId(data.uid)
        && data.orgScope is string && data.orgScope == 'orange_pro_team'
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.firstName is string && data.firstName.size() <= 60
        && data.lastName is string && data.lastName.size() <= 60
        && data.phonePro is string && data.phonePro.size() <= 30
        && isValidAvatarDataUrl(data.avatarDataUrl)
        && isValidTeamRole(data.role)
        && data.zone is string && data.zone.size() <= 100
        && data.isOnline is bool
        && data.currentDevice is string && data.currentDevice.size() <= 160
        && isValidStringList(data.devicesUsed, 12, 160)
        && data.lastLoginAt is string && data.lastLoginAt.size() <= 64
        && data.lastLogoutAt is string && data.lastLogoutAt.size() <= 64
        && data.lastSeenAt is string && data.lastSeenAt.size() <= 64
        && data.lastWorkDisconnectAt is string && data.lastWorkDisconnectAt.size() <= 64
        && data.workHoursDisconnectCount is int && data.workHoursDisconnectCount >= 0 && data.workHoursDisconnectCount <= 100000
        && isValidStringList(data.workHoursDisconnectTimes, 30, 80)
        && data.activeDateKey is string && data.activeDateKey.size() <= 16
        && data.todayWorkedSeconds is int && data.todayWorkedSeconds >= 0 && data.todayWorkedSeconds <= 86400
        && data.totalWorkedSeconds is int && data.totalWorkedSeconds >= 0 && data.totalWorkedSeconds <= 100000000
        && data.currentSessionId is string && (data.currentSessionId == '' || isValidId(data.currentSessionId))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAttendanceSession(data, userId, sessionId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'orgScope', 'dateKey', 'loginAt', 'lastSeenAt',
          'logoutAt', 'workedSeconds', 'deviceLabel', 'deviceType', 'status',
          'disconnectReason', 'disconnectedDuringWorkHours', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'orgScope', 'dateKey', 'loginAt', 'lastSeenAt',
          'logoutAt', 'workedSeconds', 'deviceLabel', 'deviceType', 'status',
          'disconnectReason', 'disconnectedDuringWorkHours', 'createdAt', 'updatedAt'
        ])
        && data.id is string
        && data.id == sessionId
        && isValidId(data.id)
        && data.ownerId is string
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.orgScope is string && data.orgScope == 'orange_pro_team'
        && data.dateKey is string && data.dateKey.size() >= 8 && data.dateKey.size() <= 16
        && data.loginAt is string && data.loginAt.size() >= 1 && data.loginAt.size() <= 64
        && data.lastSeenAt is string && data.lastSeenAt.size() >= 1 && data.lastSeenAt.size() <= 64
        && data.logoutAt is string && data.logoutAt.size() <= 64
        && data.workedSeconds is int && data.workedSeconds >= 0 && data.workedSeconds <= 86400
        && data.deviceLabel is string && data.deviceLabel.size() >= 1 && data.deviceLabel.size() <= 160
        && isValidDeviceType(data.deviceType)
        && isValidSessionStatus(data.status)
        && data.disconnectReason is string && data.disconnectReason.size() <= 80
        && data.disconnectedDuringWorkHours is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserWorkspaceConfig(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'villesAll', 'villesActive', 'modeVille',
          'defaultVille', 'emailSignature', 'seeded', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'villesAll', 'villesActive', 'modeVille',
          'defaultVille', 'emailSignature', 'seeded',
          'displayName', 'avatarDataUrl', 'phonePro', 'zone', 'bio',
          'monthlyGoalContracts', 'notifyBadges', 'notifySound', 'compactUi',
          'dismissedDedupKeys', 'includePhoneOnlyDedup',
          'legalRaisonSociale', 'legalIce', 'legalAdresse', 'legalTelephone',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isValidStringList(data.villesAll, 50, 100)
        && isValidStringList(data.villesActive, 50, 100)
        && data.modeVille is string
        && data.modeVille in ['filter', 'default']
        && data.defaultVille is string
        && data.defaultVille.size() >= 1 && data.defaultVille.size() <= 80
        && data.emailSignature is string
        && data.emailSignature.size() <= 400
        && data.seeded is bool
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('avatarDataUrl' in data) || isValidAvatarDataUrl(data.avatarDataUrl))
        && (!('phonePro' in data) || (data.phonePro is string && data.phonePro.size() <= 30))
        && (!('zone' in data) || (data.zone is string && data.zone.size() <= 100))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 240))
        && (!('monthlyGoalContracts' in data) || (data.monthlyGoalContracts is int && data.monthlyGoalContracts >= 1 && data.monthlyGoalContracts <= 200))
        && (!('notifyBadges' in data) || data.notifyBadges is bool)
        && (!('notifySound' in data) || data.notifySound is bool)
        && (!('compactUi' in data) || data.compactUi is bool)
        && (!('dismissedDedupKeys' in data) || isValidStringList(data.dismissedDedupKeys, 100, 200))
        && (!('includePhoneOnlyDedup' in data) || data.includePhoneOnlyDedup is bool)
        && (!('legalRaisonSociale' in data) || (data.legalRaisonSociale is string && data.legalRaisonSociale.size() <= 200))
        && (!('legalIce' in data) || (data.legalIce is string && data.legalIce.size() <= 30))
        && (!('legalAdresse' in data) || (data.legalAdresse is string && data.legalAdresse.size() <= 300))
        && (!('legalTelephone' in data) || (data.legalTelephone is string && data.legalTelephone.size() <= 30))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFicheEntreprise(data, userId, ficheId) {
      return data.keys().hasAll([
          'ownerId', 'id', 'societe', 'secteur', 'ville', 'telephone',
          'email', 'contact', 'role', 'source', 'effectif', 'statut',
          'dateAjout', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'id', 'numeroFiche', 'societe', 'secteur', 'ville',
          'telephone', 'telephonesSupplementaires', 'email', 'emailsSupplementaires',
          'contact', 'role', 'source', 'effectif', 'statut', 'statutUpdatedAt',
          'siteWeb', 'verifieWeb', 'pistesEnrichissement',
          'prochaineRelanceAt', 'rdvAt', 'rdvLieu',
          'dateAjout', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.id is string
        && data.id == ficheId
        && isValidId(data.id)
        && (!('numeroFiche' in data) || isValidNumeroFiche(data.numeroFiche))
        && data.societe is string && data.societe.size() >= 1 && data.societe.size() <= 200
        && isValidSecteur(data.secteur)
        && data.ville is string && data.ville.size() <= 100
        && data.telephone is string && data.telephone.size() <= 30
        && (!('telephonesSupplementaires' in data) || isValidStringList(data.telephonesSupplementaires, 10, 30))
        && data.email is string && data.email.size() <= 160
        && (!('emailsSupplementaires' in data) || isValidStringList(data.emailsSupplementaires, 10, 160))
        && data.contact is string && data.contact.size() <= 160
        && data.role is string && data.role.size() <= 120
        && data.source is string && data.source.size() <= 500
        && data.effectif is string && data.effectif.size() <= 20
        && isValidStatut(data.statut)
        && (!('statutUpdatedAt' in data) || (data.statutUpdatedAt is string && data.statutUpdatedAt.size() <= 64))
        && (!('siteWeb' in data) || (data.siteWeb is string && data.siteWeb.size() <= 500))
        && (!('verifieWeb' in data) || (data.verifieWeb is bool))
        && (!('pistesEnrichissement' in data) || isValidStringList(data.pistesEnrichissement, 15, 250))
        && (!('prochaineRelanceAt' in data) || (data.prochaineRelanceAt is string && data.prochaineRelanceAt.size() <= 64))
        && (!('rdvAt' in data) || (data.rdvAt is string && data.rdvAt.size() <= 64))
        && (!('rdvLieu' in data) || (data.rdvLieu is string && data.rdvLieu.size() <= 160))
        && data.dateAjout is string && data.dateAjout.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFicheActivite(data, userId, ficheId, activiteId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'ficheId', 'type', 'resultat', 'texte',
          'auteurNom', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'ficheId', 'type', 'resultat', 'texte',
          'auteurNom', 'rdvAt', 'rdvLieu', 'prochaineRelanceAt',
          'createdAt', 'updatedAt'
        ])
        && data.id is string
        && data.id == activiteId
        && isValidId(data.id)
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.ficheId is string
        && data.ficheId == ficheId
        && isValidId(data.ficheId)
        && isValidActiviteType(data.type)
        && isValidActiviteResultat(data.resultat)
        && data.texte is string && data.texte.size() <= 1000
        && data.auteurNom is string && data.auteurNom.size() >= 1 && data.auteurNom.size() <= 120
        && (!('rdvAt' in data) || (data.rdvAt is string && data.rdvAt.size() <= 64))
        && (!('rdvLieu' in data) || (data.rdvLieu is string && data.rdvLieu.size() <= 160))
        && (!('prochaineRelanceAt' in data) || (data.prochaineRelanceAt is string && data.prochaineRelanceAt.size() <= 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEmailSkill(data, userId, skillId) {
      return data.keys().hasAll([
          'ownerId', 'id', 'nom', 'description', 'role', 'regles', 'ctaStyle',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'id', 'nom', 'description', 'role', 'regles', 'ctaStyle',
          'isBuiltin', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.id is string
        && data.id == skillId
        && isValidId(data.id)
        && data.nom is string && data.nom.size() >= 1 && data.nom.size() <= 120
        && data.description is string && data.description.size() <= 300
        && data.role is string && data.role.size() <= 200
        && data.regles is string && data.regles.size() <= 4000
        && data.ctaStyle is string && data.ctaStyle.size() <= 300
        && (!('isBuiltin' in data) || (data.isBuiltin is bool))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Collection: /api_keys/{provider} (Super-Admin-Only Cloud API Keys Vault — Client Read/Write Strictly Denied)
    match /api_keys/{provider} {
      allow read, write: if false;
    }

    // 5. Collection: /app_users/{userId} (Admin-Managed Authorized Users Directory)
    match /app_users/{userId} {
      // Super-Admin can inspect any user; a signed-in user can only check their own authorization doc.
      allow get: if isValidId(userId) && (
        isSuperAdmin()
        || (isSignedIn() && request.auth.uid == userId && (resource == null || existing().uid == request.auth.uid))
      );

      // Strictly Super-Admin only; query MUST filter by createdBy == request.auth.uid (no get()/exists() in list).
      allow list: if isSuperAdmin() && resource.data.createdBy == request.auth.uid;

      allow create: if isSuperAdmin()
        && isValidId(userId)
        && isValidAppUser(incoming(), userId)
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSuperAdmin()
        && isValidId(userId)
        && isValidAppUser(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Admin updates user profile, role, zone, or active status
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'role', 'zone', 'active', 'updatedAt'
          ])
        );

      allow delete: if isSuperAdmin() && isValidId(userId);
    }

    // 6. Collection: /team_stats/{userId} (Non-PII Team Leaderboard, XP, Badges & Monthly Trends)
    match /team_stats/{userId} {
      allow get: if isValidId(userId)
        && (isSuperAdmin() || isApprovedMember(request.auth.uid))
        && (resource == null || existing().orgScope == 'orange_pro_team');

      // Query requires active approved member or Super-Admin and orgScope == 'orange_pro_team'.
      allow list: if (isSuperAdmin() || isApprovedMember(request.auth.uid))
        && resource.data.orgScope == 'orange_pro_team';

      allow create: if isValidId(userId)
        && isValidTeamStat(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isSuperAdmin()
          || (
            isApprovedMember(userId)
            && incoming().uid == request.auth.uid
            && incoming().xp == 0
            && incoming().totalContracts == 0
            && incoming().totalPayoutMad == 0
            && incoming().unlockedCount == 0
            && incoming().totalProspects == 0
            && incoming().totalQualified == 0
            && incoming().manualBadges.size() == 0
            && incoming().role == get(/databases/$(database)/documents/app_users/$(userId)).data.role
            && incoming().active == true
          )
        );

      allow update: if isValidId(userId)
        && isValidTeamStat(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().orgScope == existing().orgScope
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Super-Admin awards manual badges or updates any team stat fields
          (
            isSuperAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'role', 'zone', 'active', 'avatarDataUrl',
              'totalProspects', 'totalQualified', 'totalContracts', 'totalPayoutMad',
              'xp', 'unlockedCount', 'manualBadges', 'monthlyHistory', 'updatedAt'
            ])
          )
          ||
          // Action 2: Collaborator updates ONLY displayName, zone, avatarDataUrl (cannot alter financial counters, role, or active)
          (
            isOwner(userId)
            && incoming().uid == request.auth.uid
            && incoming().manualBadges == existing().manualBadges
            && incoming().role == existing().role
            && incoming().active == existing().active
            && incoming().totalProspects == existing().totalProspects
            && incoming().totalQualified == existing().totalQualified
            && incoming().totalContracts == existing().totalContracts
            && incoming().totalPayoutMad == existing().totalPayoutMad
            && incoming().xp == existing().xp
            && incoming().unlockedCount == existing().unlockedCount
            && incoming().monthlyHistory == existing().monthlyHistory
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'zone', 'avatarDataUrl', 'updatedAt'
            ])
          )
        );

      allow delete: if isSuperAdmin() && isValidId(userId);
    }

    // 7. Collection: /signed_contracts/{contractId} (Signed Contracts & Commission Payout Ledger — No Client PII)
    match /signed_contracts/{contractId} {
      allow get: if isValidId(contractId) && (
        isSuperAdmin()
        || (isTeamLeadOrManager() && (resource == null || existing().orgScope == 'orange_pro_team'))
        || (isApprovedMember(request.auth.uid) && (resource == null || existing().ownerId == request.auth.uid))
      );

      // Super-Admin and Manager/Team-Lead list team contracts; collaborators list ONLY their own.
      allow list: if (isSuperAdmin() && resource.data.orgScope == 'orange_pro_team')
        || (isTeamLeadOrManager() && resource.data.orgScope == 'orange_pro_team')
        || (isVerifiedUser() && resource.data.ownerId == request.auth.uid);

      allow create: if isValidId(contractId)
        && isValidSignedContract(incoming(), contractId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isSuperAdmin()
          || isTeamLeadOrManager()
          || (
            incoming().payoutMad == 0
            && incoming().payoutStatus == 'En attente'
            && isApprovedMember(request.auth.uid)
            && incoming().ownerId == request.auth.uid
          )
        );

      // Payout amounts, products, and statuses are controlled by Super-Admin, Managers and Team Leads.
      // Immutable identity/client/timestamp fields cannot be modified (enforced via affectedKeys).
      // Transition to 'Versé' strictly requires a non-empty referenceVirement (max 80).
      // Transition to 'Refusé' strictly requires a non-empty refusMotif (max 200).
      allow update: if isValidId(contractId)
        && (isSuperAdmin() || isTeamLeadOrManager())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'produitOrangePro', 'tier', 'payoutMad', 'payoutStatus',
          'referenceVirement', 'refusMotif', 'updatedAt'
        ])
        && incoming().produitOrangePro is string
        && incoming().produitOrangePro.size() >= 1
        && incoming().produitOrangePro.size() <= 200
        && isValidOrangeTier(incoming().tier)
        && incoming().payoutMad is number
        && incoming().payoutMad >= 0
        && incoming().payoutMad <= 10000000
        && isValidPayoutStatus(incoming().payoutStatus)
        && (
          !('referenceVirement' in incoming())
          || (incoming().referenceVirement is string && incoming().referenceVirement.size() <= 80)
        )
        && (
          !('refusMotif' in incoming())
          || (incoming().refusMotif is string && incoming().refusMotif.size() <= 200)
        )
        && (
          incoming().payoutStatus != 'Versé'
          || (
            'referenceVirement' in incoming()
            && incoming().referenceVirement is string
            && incoming().referenceVirement.size() >= 1
            && incoming().referenceVirement.size() <= 80
          )
        )
        && (
          incoming().payoutStatus != 'Refusé'
          || (
            'refusMotif' in incoming()
            && incoming().refusMotif is string
            && incoming().refusMotif.size() >= 1
            && incoming().refusMotif.size() <= 200
          )
        );

      allow delete: if isSuperAdmin() && isValidId(contractId);
    }

    // 8. Collection: /user_presence/{userId} (PII Profile, Devices & Work-Hours Attendance — Owner & Super-Admin ONLY)
    match /user_presence/{userId} {
      allow get: if isValidId(userId) && (
        isSuperAdmin()
        || (isOwner(userId) && (resource == null || existing().uid == request.auth.uid))
      );

      // Strictly Super-Admin only; query MUST filter by orgScope == 'orange_pro_team'.
      allow list: if isSuperAdmin() && resource.data.orgScope == 'orange_pro_team';

      allow create: if isValidId(userId)
        && isValidUserPresence(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isSuperAdmin()
          || (
            isOwner(userId)
            && incoming().uid == request.auth.uid
            && incoming().role == get(/databases/$(database)/documents/app_users/$(userId)).data.role
          )
        );

      allow update: if isValidId(userId)
        && isValidUserPresence(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().orgScope == existing().orgScope
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Super-Admin updates collaborator profile metadata or own presence
          (
            isSuperAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'firstName', 'lastName', 'phonePro', 'avatarDataUrl',
              'role', 'zone', 'isOnline', 'currentDevice', 'devicesUsed',
              'lastLoginAt', 'lastLogoutAt', 'lastSeenAt', 'lastWorkDisconnectAt',
              'workHoursDisconnectCount', 'workHoursDisconnectTimes',
              'activeDateKey', 'todayWorkedSeconds', 'totalWorkedSeconds',
              'currentSessionId', 'updatedAt'
            ])
          )
          ||
          // Action 2: Collaborator updates own profile, device list, and live attendance status (role immutable)
          (
            isOwner(userId)
            && incoming().uid == request.auth.uid
            && incoming().role == existing().role
            && (
              (
                incoming().activeDateKey == existing().activeDateKey
                && incoming().todayWorkedSeconds >= existing().todayWorkedSeconds
                && incoming().todayWorkedSeconds <= existing().todayWorkedSeconds + 120
              )
              || (
                incoming().activeDateKey != existing().activeDateKey
                && incoming().todayWorkedSeconds >= 0
                && incoming().todayWorkedSeconds <= 120
              )
            )
            && incoming().todayWorkedSeconds <= 86400
            && incoming().totalWorkedSeconds >= existing().totalWorkedSeconds
            && incoming().totalWorkedSeconds <= existing().totalWorkedSeconds + 120
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'firstName', 'lastName', 'phonePro', 'avatarDataUrl',
              'zone', 'isOnline', 'currentDevice', 'devicesUsed',
              'lastLoginAt', 'lastLogoutAt', 'lastSeenAt', 'lastWorkDisconnectAt',
              'workHoursDisconnectCount', 'workHoursDisconnectTimes',
              'activeDateKey', 'todayWorkedSeconds', 'totalWorkedSeconds',
              'currentSessionId', 'updatedAt'
            ])
          )
        );

      allow delete: if isSuperAdmin() && isValidId(userId);

      // 8b. Subcollection: /user_presence/{userId}/sessions/{sessionId} (Login/Logout & Work-Hours Sessions)
      match /sessions/{sessionId} {
        allow get: if isValidId(userId) && isValidId(sessionId) && (
          isSuperAdmin()
          || (isOwner(userId) && (resource == null || existing().ownerId == request.auth.uid))
        );

        allow list: if (isSuperAdmin() && resource.data.orgScope == 'orange_pro_team')
          || (isVerifiedUser() && request.auth.uid == userId && resource.data.ownerId == request.auth.uid);

        allow create: if isValidId(userId)
          && isValidId(sessionId)
          && isValidAttendanceSession(incoming(), userId, sessionId)
          && isOwner(userId)
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/user_presence/$(userId));

        allow update: if isValidId(userId)
          && isValidId(sessionId)
          && isValidAttendanceSession(incoming(), userId, sessionId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid
          && incoming().ownerId == existing().ownerId
          && incoming().id == existing().id
          && incoming().orgScope == existing().orgScope
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/user_presence/$(userId))
          && (
            // Action: Heartbeat or session closure (login/logout/disconnect)
            incoming().diff(existing()).affectedKeys().hasOnly([
              'lastSeenAt', 'logoutAt', 'workedSeconds', 'status',
              'disconnectReason', 'disconnectedDuringWorkHours', 'updatedAt'
            ])
          );

        allow delete: if isSuperAdmin() && isValidId(userId) && isValidId(sessionId);
      }
    }

    // 9. Collection: /users/{userId} (Workspace Settings)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId)
        && (resource == null || existing().ownerId == request.auth.uid);
      allow list: if false;

      allow create: if isValidId(userId)
        && isValidUserWorkspaceConfig(incoming(), userId)
        && isOwner(userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isValidUserWorkspaceConfig(incoming(), userId)
        && isOwner(userId)
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Update workspace & personal profile settings (cities, signature, photo, preferences, dedup choices, legal info)
          incoming().diff(existing()).affectedKeys().hasOnly([
            'villesAll', 'villesActive', 'modeVille', 'defaultVille',
            'emailSignature', 'seeded', 'displayName', 'avatarDataUrl',
            'phonePro', 'zone', 'bio', 'monthlyGoalContracts',
            'notifyBadges', 'notifySound', 'compactUi',
            'dismissedDedupKeys', 'includePhoneOnlyDedup',
            'legalRaisonSociale', 'legalIce', 'legalAdresse', 'legalTelephone',
            'updatedAt'
          ])
        );

      allow delete: if isValidId(userId) && isOwner(userId) && existing().ownerId == request.auth.uid;

      // 10. Subcollection: /users/{userId}/fiches/{ficheId} (B2B CRM Prospects — Locked after Signing for Collaborators)
      match /fiches/{ficheId} {
        allow get: if isValidId(userId) && isValidId(ficheId) && (
          (isOwner(userId) && (resource == null || existing().ownerId == request.auth.uid) && (isSuperAdmin() || resource == null || existing().statut != 'Signé Orange Pro'))
          || ((isSuperAdmin() || isTeamLeadOrManager()) && (resource == null || existing().ownerId == userId))
        );

        allow list: if isVerifiedUser() && (
          (request.auth.uid == userId && resource.data.ownerId == request.auth.uid)
          || ((isSuperAdmin() || isTeamLeadOrManager()) && resource.data.ownerId == userId)
        );

        allow create: if isValidId(userId)
          && isValidId(ficheId)
          && isValidFicheEntreprise(incoming(), userId, ficheId)
          && isOwner(userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isValidId(userId)
          && isValidId(ficheId)
          && isValidFicheEntreprise(incoming(), userId, ficheId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid
          && incoming().ownerId == existing().ownerId
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (isSuperAdmin() || existing().statut != 'Signé Orange Pro')
          && exists(/databases/$(database)/documents/users/$(userId))
          && (
            // Action 1: Kanban pipeline status transition or reminder mirror update
            incoming().diff(existing()).affectedKeys().hasOnly([
              'statut', 'statutUpdatedAt', 'prochaineRelanceAt', 'rdvAt', 'rdvLieu', 'updatedAt'
            ])
            ||
            // Action 2: Full CRM edit, multi-contact addition, web/AI enrichment, or MDM merge
            incoming().diff(existing()).affectedKeys().hasOnly([
              'numeroFiche', 'societe', 'secteur', 'ville', 'telephone',
              'telephonesSupplementaires', 'email', 'emailsSupplementaires',
              'contact', 'role', 'source', 'effectif', 'statut', 'statutUpdatedAt',
              'siteWeb', 'verifieWeb', 'pistesEnrichissement',
              'prochaineRelanceAt', 'rdvAt', 'rdvLieu',
              'dateAjout', 'updatedAt'
            ])
          );

        allow delete: if isValidId(userId)
          && isValidId(ficheId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid
          && (isSuperAdmin() || existing().statut != 'Signé Orange Pro')
          && exists(/databases/$(database)/documents/users/$(userId));

        // 10b. Subcollection: /users/{userId}/fiches/{ficheId}/activites/{activiteId} (Activity Journal, RDV & Relance)
        match /activites/{activiteId} {
          allow get: if isValidId(userId) && isValidId(ficheId) && isValidId(activiteId) && (
            (isOwner(userId) && (resource == null || existing().ownerId == request.auth.uid))
            || ((isSuperAdmin() || isTeamLeadOrManager()) && (resource == null || existing().ownerId == userId))
          );

          allow list: if isVerifiedUser() && (
            (request.auth.uid == userId && resource.data.ownerId == request.auth.uid)
            || ((isSuperAdmin() || isTeamLeadOrManager()) && resource.data.ownerId == userId)
          );

          allow create: if isValidId(userId)
            && isValidId(ficheId)
            && isValidId(activiteId)
            && isValidFicheActivite(incoming(), userId, ficheId, activiteId)
            && isOwner(userId)
            && incoming().ownerId == request.auth.uid
            && incoming().ficheId == ficheId
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time
            && exists(/databases/$(database)/documents/users/$(userId)/fiches/$(ficheId));

          allow update: if isValidId(userId)
            && isValidId(ficheId)
            && isValidId(activiteId)
            && isValidFicheActivite(incoming(), userId, ficheId, activiteId)
            && isOwner(userId)
            && existing().ownerId == request.auth.uid
            && incoming().ownerId == existing().ownerId
            && incoming().ficheId == existing().ficheId
            && incoming().id == existing().id
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && exists(/databases/$(database)/documents/users/$(userId)/fiches/$(ficheId))
            && (
              incoming().diff(existing()).affectedKeys().hasOnly([
                'type', 'resultat', 'texte', 'auteurNom', 'rdvAt', 'rdvLieu', 'prochaineRelanceAt', 'updatedAt'
              ])
            );

          allow delete: if isValidId(userId)
            && isValidId(ficheId)
            && isValidId(activiteId)
            && (isSuperAdmin() || (isOwner(userId) && existing().ownerId == request.auth.uid))
            && exists(/databases/$(database)/documents/users/$(userId)/fiches/$(ficheId));
        }
      }

      // 11. Subcollection: /users/{userId}/skills/{skillId} (Email Studio Skills)
      match /skills/{skillId} {
        allow get: if isValidId(userId) && isValidId(skillId) && isOwner(userId)
          && (resource == null || existing().ownerId == request.auth.uid);

        allow list: if isVerifiedUser()
          && request.auth.uid == userId
          && resource.data.ownerId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(skillId)
          && isValidEmailSkill(incoming(), userId, skillId)
          && isOwner(userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isValidId(userId)
          && isValidId(skillId)
          && isValidEmailSkill(incoming(), userId, skillId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid
          && incoming().ownerId == existing().ownerId
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && (
            // Action: Edit skill metadata and rules
            incoming().diff(existing()).affectedKeys().hasOnly([
              'nom', 'description', 'role', 'regles', 'ctaStyle', 'isBuiltin', 'updatedAt'
            ])
          );

        allow delete: if isValidId(userId)
          && isValidId(skillId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid
          && exists(/databases/$(database)/documents/users/$(userId));
      }
    }
  }
}
